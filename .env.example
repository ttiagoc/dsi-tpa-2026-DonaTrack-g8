# ========================================================
# Variables de entorno para DonaTrack (Docker & Local)
# Copiá este archivo como .env y completá con tus datos:
#   cp .env.example .env
# ========================================================

# Configuración de Notificaciones por Email (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=tu-email-de-brevo@correo.com
SMTP_PASSWORD=xsmtpsib-tu-clave-aqui

# Seguridad y Claves de Servicio (Opcional, tienen valores por defecto para local)
# JWT_SECRET=donatrack-secreto-solo-para-desarrollo-local-0123456789
# SERVICE_API_KEY=donatrack-clave-servicios-local
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin1234

# Correos de las personas administradoras (separados por coma): reciben los avisos de entrega no satisfactoria
# ADMIN_EMAILS=admin1@correo.com,admin2@correo.com


# URL pública del sitio (web-service): va en los links de los avisos (donación en camino, acceso inicial, ...)
# WEB_APP_URL=https://donatrack.ejemplo.com
