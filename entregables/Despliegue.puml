@startuml Despliegue

' Forzar orientación horizontal y líneas limpias
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

' Estilos y Colores Globales
skinparam node {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #0D47A1
    FontStyle bold
}
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    FontColor #212121
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #BDBDBD
    FontColor #424242
    FontStyle bold
}
skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    FontColor #1B5E20
    FontStyle bold
}
skinparam cloud {
    BackgroundColor #E0F7FA
    BorderColor #00ACC1
    FontColor #006064
    FontStyle bold
}

' --- 1. CAPA CLIENTE ---
node "Computadora Personal" <<Device>> {
    component "Navegador Web" as Nav
}

' --- RED INTERMEDIA ---
cloud "Internet" as Net

' --- 2. CAPA FRONTEND ---
' Cliente liviano con MVC del lado del servidor: arma el HTML y solo habla HTTP con las APIs
' (sin base de datos propia). La sesion vive en memoria del servidor; el navegador solo
' guarda la cookie donatrack_session (HttpOnly, SameSite=Lax, Secure en la nube).
rectangle "Capa de Presentación" {
    node "Servidor Web" as NodeWeb {
        component "web-service\n(Javalin + Handlebars)\npuerto 7070" as Front
        component "Sesiones en memoria\n(tokens JWT por usuario)" as Sesiones
    }
}

' --- 3. CAPA DOMINIO (MICROSERVICIOS) ---
rectangle "Capa de Dominio" {
    node "Servidor Donaciones" as NodeS1 {
        component "Microservicio Donaciones" as S1
    }
    node "Servidor Logística" as NodeS2 {
        component "Microservicio Logística" as S2
    }
    node "Servidor Notificaciones" as NodeS3 {
        component "Microservicio Notificaciones" as S3
    }
}

' --- 4. CAPA PERSISTENCIA Y EXTERNOS ---
' Cada microservicio tiene su propia base de datos: ningun servicio accede
' a los datos de otro, solo se comunican por API REST.
rectangle "Capa de Persistencia" {
    database "Servidor BD Donaciones" as NodeDB1 {
        component "PostgreSQL\nbase: donaciones" as DB1
    }
    database "Servidor BD Logística" as NodeDB2 {
        component "PostgreSQL\nbase: logistica" as DB2
    }
    database "Servidor BD Notificaciones" as NodeDB3 {
        component "PostgreSQL\nbase: notificaciones" as DB3
    }
}

node "Sistemas Externos" <<External System>> #ECEFF1 {
    component "APIs de Mensajería" as Ext
    component "Componente de Planificación de Rutas" as Planif
}

' --- ALINEACIÓN VERTICAL INTERNA ---
NodeS1 -[hidden]down-> NodeS2
NodeS2 -[hidden]down-> NodeS3
NodeDB1 -[hidden]down-> NodeDB2
NodeDB2 -[hidden]down-> NodeDB3

' --- FLUJOS Y CONEXIONES (Izquierda a Derecha) ---

' Cliente -> Internet -> Frontend
Nav --> Net : HTTPS (HTML + cookie de sesión)
Net --> Front : HTTPS

Front -- Sesiones

' Frontend -> Microservicios (Authorization: Bearer <JWT>; login y registro en /api/auth de Donaciones)
Front --> S1 : HTTP - API REST + JWT
Front --> S2 : HTTP - API REST + JWT
Front --> S3 : HTTP - API REST + JWT

' Conexiones cruzadas entre Microservicios
S1 <--> S2 : HTTP - API REST
S2 <--> S3 : HTTP - API REST
S1 <--> S3 : HTTP - API REST

' Microservicios -> Base de Datos propia (JPA/Hibernate sobre JDBC)
S1 --> DB1 : TCP/IP - JDBC
S2 --> DB2 : TCP/IP - JDBC
S3 --> DB3 : TCP/IP - JDBC

' Salida a Sistemas Externos
S3 --> Ext : HTTPS
S2 <--> Planif : HTTP - API REST

@enduml