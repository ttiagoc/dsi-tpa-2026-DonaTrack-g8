@startuml Despliegue

' Despliegue en Azure en cuatro piezas dentro de la misma VNet (ver deploy/README.md):
' - VM de servicios: Caddy (balanceador + HTTPS) y dos instancias de cada servicio y del web-service,
'   con deploy/servicios/docker-compose.yml.
' - Azure Database for PostgreSQL con las tres bases.
' - VM de cron: dispara las tareas programadas por la red privada, contra el balanceador.
' - Azure Files: las fotos de recepcion, montadas en la VM de servicios.
' Desde Internet solo entra Caddy (80/443).

left to right direction
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

skinparam node {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #0D47A1
    FontStyle bold
}
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    FontColor #212121
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #BDBDBD
    FontColor #424242
    FontStyle bold
}
skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    FontColor #1B5E20
    FontStyle bold
}
skinparam cloud {
    BackgroundColor #E0F7FA
    BorderColor #00ACC1
    FontColor #006064
    FontStyle bold
}
skinparam storage {
    BackgroundColor #FFF3E0
    BorderColor #FB8C00
    FontColor #E65100
    FontStyle bold
}

' --- 1. CLIENTE ---
node "Dispositivo del usuario" <<Device>> {
    component "Navegador web\n(donante, entidad, administrador\no chofer; desktop o celular)" as Nav
}

cloud "Internet" as Net

' --- 2. AZURE ---
rectangle "Microsoft Azure (Azure for Students, Chile Central)" {

    rectangle "Network Security Group\n(entrada publica: 80, 443 y 22 para SSH)" as NSG

    rectangle "Red virtual (VNet) donatrack-vnet" {

        node "VM de servicios donatrack-vm (B2as v2)\n(Ubuntu 24.04 + Docker Engine)\ndonatrack-g8.chilecentral.cloudapp.azure.com" <<VM>> as VM {

            node "Contenedor donatrack-caddy" <<Docker>> as CCaddy {
                component "Caddy 2\nbalanceador de carga + HTTPS\n(Let's Encrypt)\n:443 sitio (sesiones pegajosas)\n:8080 / :8081 / :8082 APIs" as Caddy
            }

            node "web-1 / web-2" <<Docker x2>> as CWeb {
                component "web-service\n(Javalin + Handlebars)\n:7070" as Web
            }

            node "donaciones-1 / donaciones-2" <<Docker x2>> as CDon {
                component "donaciones-service\n(Spring Boot)\nREST :8080\ngRPC server :9090" as Don
            }

            node "logistica-1 / logistica-2" <<Docker x2>> as CLog {
                component "logistica-service\n(Spring Boot)\nREST :8081\ngRPC client" as Log
            }

            node "notificaciones-1 / notificaciones-2" <<Docker x2>> as CNot {
                component "notificaciones-service\n(Spring Boot)\nREST :8082" as Not
            }

            storage "/mnt/donatrack-fotos\n(montado desde Azure Files)" as MntFotos
        }

        node "VM de cron donatrack-cron (B1s)\n(sin IP publica)" <<VM>> as VMCron {
            component "cron\n/etc/cron.d/donatrack\n(docker/cron/donatrack-cron.sh)\n01:00 matchmaking\n03:00 rutas\n04:00 inactividad" <<cron>> as Cron
        }

        database "Azure Database for PostgreSQL\nFlexible Server (B1ms)\n:5432, acceso privado" as PG {
            component "Base donaciones" as DB1
            component "Base logistica" as DB2
            component "Base notificaciones" as DB3
        }

        storage "Azure Files\nfile share fotos\n(fotos de recepcion)" as Files
    }
}

' --- 3. SERVICIOS EXTERNOS ---
node "Servicios externos" <<External System>> #ECEFF1 {
    component "Componente externo de\nplanificacion de rutas\n(en la entrega lo simula\nGestorPlanificacionRutas)" as Planif
    component "Georef API\n(apis.datos.gob.ar)\nvalidar y ubicar direcciones" as Georef
    component "Mensajeria\nSMTP (Brevo) / Resend\nTwilio (SMS y WhatsApp)" as Msg
    component "OpenStreetMap + Leaflet\n(teselas del mapa y libreria JS)" as OSM
}

' --- Alineacion ---
CCaddy -[hidden]down-> CWeb
CWeb -[hidden]down-> MntFotos
CDon -[hidden]down-> CLog
CLog -[hidden]down-> CNot
DB1 -[hidden]down-> DB2
DB2 -[hidden]down-> DB3

' --- Conexiones ---
Nav --> Net : HTTPS (HTML + cookie de sesion\n+ cookie de instancia)
Net --> NSG
NSG --> Caddy : :443 (el :80 redirige a HTTPS)
Nav --> OSM : HTTPS (mapas de entregas y hoja de ruta)

Caddy --> Web : HTTP :7070, a la misma instancia\nde cada usuario
Caddy --> Don : :8080 round robin
Caddy --> Log : :8081 round robin
Caddy --> Not : :8082 round robin

Web --> Caddy : REST + JWT (http://caddy:8080..8082/api)
Web --> MntFotos : fotos de recepcion
MntFotos --> Files : SMB 3

Cron --> Caddy : curl por la red privada\nhttp://<IP privada>:8080 y :8081\n(X-Api-Key)

Log --> Don : gRPC sobre HTTP/2 :9090\nalias donaciones-service\n[x-api-key en metadata]
Log --> Planif : HTTPS: donaciones (lotes de hasta 100) + camiones
Planif --> Log : callback asincronico\nPOST /api/rutas/planificaciones/resultados

Don --> DB1 : JDBC (TLS)
Log --> DB2 : JDBC (TLS)
Not --> DB3 : JDBC (TLS)

Don --> Georef : HTTPS
Not --> Msg : SMTP / HTTPS (email, SMS, WhatsApp)

@enduml
