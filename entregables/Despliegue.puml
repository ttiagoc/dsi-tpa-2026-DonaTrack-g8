@startuml Despliegue

' Despliegue en Azure: una maquina virtual con Docker que levanta todo con
' "docker compose --profile full up -d --build" (ver docker-compose.yml).
' Los servicios se hablan por la red interna de compose usando el nombre del servicio.

left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

skinparam node {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #0D47A1
    FontStyle bold
}
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    FontColor #212121
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #BDBDBD
    FontColor #424242
    FontStyle bold
}
skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    FontColor #1B5E20
    FontStyle bold
}
skinparam cloud {
    BackgroundColor #E0F7FA
    BorderColor #00ACC1
    FontColor #006064
    FontStyle bold
}
skinparam storage {
    BackgroundColor #FFF3E0
    BorderColor #FB8C00
    FontColor #E65100
    FontStyle bold
}

' --- 1. CLIENTE ---
node "Dispositivo del usuario" <<Device>> {
    component "Navegador web\n(donante, entidad, administrador\no chofer; desktop o celular)" as Nav
}

cloud "Internet" as Net

' --- 2. AZURE ---
rectangle "Microsoft Azure (Azure for Students)" {

    rectangle "Network Security Group\n(entrada publica solo al puerto del web-service)" as NSG

    node "Azure Virtual Machine\n(Linux + Docker Engine)" <<VM>> as VM {

        rectangle "Red interna de docker compose (donatrack)" {

            node "Contenedor donatrack-web" <<Docker>> as CWeb {
                component "web-service\n(Javalin + Handlebars)\n:7070" as Web
            }

            node "Contenedor donatrack-donaciones" <<Docker>> as CDon {
                component "donaciones-service\n(Spring Boot)\nREST :8080\ngRPC server :9090" as Don
            }

            node "Contenedor donatrack-logistica" <<Docker>> as CLog {
                component "logistica-service\n(Spring Boot)\nREST :8081\ngRPC client" as Log
            }

            node "Contenedor donatrack-notificaciones" <<Docker>> as CNot {
                component "notificaciones-service\n(Spring Boot)\nREST :8082" as Not
            }

            database "Contenedor donatrack-postgres\nPostgreSQL 16 :5432" as PG {
                component "Base donaciones" as DB1
                component "Base logistica" as DB2
                component "Base notificaciones" as DB3
            }
        }

        storage "Volumen Docker fotos-data\n(/data/fotos)" as VolFotos
        storage "Volumen Docker postgres-data" as VolPG
    }
}

' --- 3. SERVICIOS EXTERNOS ---
node "Servicios externos" <<External System>> #ECEFF1 {
    component "Componente externo de\nplanificacion de rutas\n(en la entrega lo simula\nGestorPlanificacionRutas)" as Planif
    component "Georef API\n(apis.datos.gob.ar)\nvalidar y ubicar direcciones" as Georef
    component "Mensajeria\nSMTP (Brevo) / Resend\nTwilio (SMS y WhatsApp)" as Msg
    component "OpenStreetMap + Leaflet\n(teselas del mapa y libreria JS)" as OSM
}

' --- Alineacion ---
CWeb -[hidden]down-> VolFotos
CDon -[hidden]down-> CLog
CLog -[hidden]down-> CNot
DB1 -[hidden]down-> DB2
DB2 -[hidden]down-> DB3
PG -[hidden]down-> VolPG

' --- Conexiones ---
Nav --> Net : HTTP (HTML + cookie de sesion)
Net --> NSG
NSG --> Web : :7070
Nav --> OSM : HTTPS (mapas de entregas y hoja de ruta)

Web --> VolFotos : fotos de recepcion
Web --> Don : REST :8080 + JWT\n(login, catalogo, donaciones, entidades)
Web --> Log : REST :8081 + JWT\n(camiones, rutas, posiciones)
Web --> Not : REST :8082 + JWT\n(notificaciones de cada usuario)

Log --> Don : gRPC sobre HTTP/2 :9090\n[x-api-key en metadata]
Log --> Planif : HTTPS: donaciones (lotes de hasta 100) + camiones
Planif --> Log : callback asincronico HTTPS\nPOST /api/rutas/planificaciones/resultados

Don --> Not : REST :8082\n(eventos de donaciones)
Log --> Not : REST :8082 + X-Api-Key\n(inicio de ruta)

Don --> DB1 : JDBC
Log --> DB2 : JDBC
Not --> DB3 : JDBC
PG --> VolPG

Don --> Georef : HTTPS
Not --> Msg : SMTP / HTTPS (email, SMS, WhatsApp)

@enduml
