@startuml Despliegue

' Forzar orientación horizontal y líneas limpias
left to right direction
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

' Estilos y Colores Globales
skinparam node {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontColor #0D47A1
    FontStyle bold
}
skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    FontColor #212121
}
skinparam rectangle {
    BackgroundColor #F5F5F5
    BorderColor #BDBDBD
    FontColor #424242
    FontStyle bold
}
skinparam database {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    FontColor #1B5E20
    FontStyle bold
}
skinparam cloud {
    BackgroundColor #E0F7FA
    BorderColor #00ACC1
    FontColor #006064
    FontStyle bold
}
skinparam storage {
    BackgroundColor #FFF3E0
    BorderColor #FB8C00
    FontColor #E65100
    FontStyle bold
}

' --- 1. CAPA CLIENTE ---
node "Dispositivo Usuario" <<Device>> {
    component "Navegador Web\n(Desktop / Mobile)" as Nav
}

' --- RED INTERMEDIA ---
cloud "Internet Pública" as Net

' --- 2. ENTORNO CLOUD (INFRAESTRUCTURA DE DESPLIEGUE) ---
rectangle "Infraestructura Cloud (Red Privada / VPC)" {

    ' Capa de Presentación (Frontend)
    node "Nodo Cloud: Web" as NodeWeb {
        component "web-service\n(Javalin + Handlebars)\nPuerto :7070" as Front
        component "Sesiones en Memoria\n(JWT por usuario)" as Sesiones
    }

    storage "Volumen Persistente\n(/data/fotos)" as StorageFotos

    ' Capa de Dominio (Microservicios en Nodos Separados)
    node "Nodo Cloud: Donaciones (Principal)" as NodeS1 {
        component "donaciones-service\n(Spring Boot)\nREST :8080\ngRPC Server :9090" as S1
    }

    node "Nodo Cloud: Logística (Extraído)" as NodeS2 {
        component "logistica-service\n(Spring Boot)\nREST :8081\ngRPC Client" as S2
    }

    node "Nodo Cloud: Notificaciones" as NodeS3 {
        component "notificaciones-service\n(Spring Boot)\nREST :8082" as S3
    }

    ' Capa de Persistencia Administrada
    database "PostgreSQL Administrado\n(Managed DB / Neon)" as NodeDB {
        component "Base donaciones" as DB1
        component "Base logistica" as DB2
        component "Base notificaciones" as DB3
    }
}

' --- 3. SISTEMAS EXTERNOS ---
node "Sistemas Externos" <<External System>> #ECEFF1 {
    component "APIs de Mensajería\n(Resend / Twilio)" as Ext
    component "Componente Externo de\nPlanificación de Rutas" as Planif
}

' --- ALINEACIÓN VERTICAL INTERNA ---
NodeWeb -[hidden]down-> StorageFotos
NodeS1 -[hidden]down-> NodeS2
NodeS2 -[hidden]down-> NodeS3
DB1 -[hidden]down-> DB2
DB2 -[hidden]down-> DB3

' --- FLUJOS Y CONEXIONES ---

' Cliente -> Internet -> Frontend Web
Nav --> Net : HTTPS (HTML + cookie donatrack_session)
Net --> Front : HTTPS (Reverse Proxy / SSL)
Front -- Sesiones
Front --> StorageFotos : Almacenamiento fotos recepción (disco persistente)

' Frontend -> Microservicios (Red Privada, REST + JWT Bearer)
Front --> S1 : HTTP/1.1 REST (:8080) + JWT
Front --> S2 : HTTP/1.1 REST (:8081) + JWT
Front --> S3 : HTTP/1.1 REST (:8082) + JWT

' Integración inter-servicios: Logística -> Donaciones vía gRPC HTTP/2
S2 --> S1 : gRPC sobre HTTP/2 (:9090)\n[x-api-key en metadata]

' Integración inter-servicios: Notificaciones vía REST
S1 --> S3 : HTTP REST (:8082)\n[notificaciones de eventos]
S2 --> S3 : HTTP REST (:8082)\n[notificaciones de rutas]

' Microservicios -> PostgreSQL Administrado (Bases separadas)
S1 --> DB1 : TCP/IP JDBC (SSL)
S2 --> DB2 : TCP/IP JDBC (SSL)
S3 --> DB3 : TCP/IP JDBC (SSL)

' Salida a Sistemas Externos
S3 --> Ext : HTTPS (Email / WhatsApp / SMS)
S2 <--> Planif : HTTP REST (Callback asíncrono)

@enduml
