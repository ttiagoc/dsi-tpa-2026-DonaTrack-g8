@startuml Clases
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
hide empty members

package "Common Lib" {
  class MedioContacto {
    valor : String
    tipoContacto : TipoContacto
  }

  enum TipoContacto {
    EMAIL
    SMS
    WHATSAPP
  }

  enum Rol {
    DONANTE
    ENTIDAD_BENEFICIARIA
    CHOFER
    ADMINISTRADOR
    SISTEMA
  }
}

package "Microservicio Notificaciones" {
  interface EstrategiaNotificacion {
    getTipoContacto() : TipoContacto
    notificar(valor : String, mensaje : String) : void
  }

  interface ProveedorEmail {
    enviarEmail(destino: String, mensaje: String) : void
  }

  interface ProveedorSMS {
    enviarSMS(destino: String, mensaje: String) : void
  }

  interface ProveedorWhatsapp {
    enviarWhatsapp(destino: String, mensaje: String) : void
  }

  class ResendAdapter implements ProveedorEmail {
    enviarEmail(destino: String, mensaje: String) : void
  }

  class SmtpEmailAdapter implements ProveedorEmail {
    enviarEmail(destino: String, mensaje: String) : void
  }

  class TwilioAdapter implements ProveedorSMS, ProveedorWhatsapp {
    enviarSMS(destino: String, mensaje: String) : void
    enviarWhatsapp(destino: String, mensaje: String) : void
  }

  class Email implements EstrategiaNotificacion {
    proveedorEmail: ProveedorEmail
    tipoContacto: TipoContacto
    getTipoContacto() : TipoContacto
    notificar(valor : String, mensaje : String) : void
  }

  class SMS implements EstrategiaNotificacion {
    proveedorSMS: ProveedorSMS
    tipoContacto: TipoContacto
    getTipoContacto() : TipoContacto
    notificar(valor : String, mensaje : String) : void
  }

  class WhatsApp implements EstrategiaNotificacion {
    proveedorWhatsapp: ProveedorWhatsapp
    tipoContacto: TipoContacto
    getTipoContacto() : TipoContacto
    notificar(valor : String, mensaje : String) : void
  }

  class Notificador {
    estrategiasContactos : Map<TipoContacto, EstrategiaNotificacion>
    enviarNotificacion(notificacionRequest : NotificacionRequest) : void
    notificar(notificacion : Notificacion) : void
  }

  class Notificacion {
    id : Long
    fechaDeEnvio : LocalDateTime
    mensaje : String
    contacto : MedioContacto
    completada : Boolean
    tipoEvento : String
    tipoDestinatario : String
    destinatarioId : Long
    donacionId : Long
  }
}

package "Microservicio Donaciones" {
  abstract class Donante {
    id : Long
    donaciones : List<RegistroDonacion>
    contactos: List<MedioContacto>
    contactoPredeterminado: MedioContacto
    agregarDonacion(donacion: RegistroDonacion) : void
    getFechaUltimaDonacion() : LocalDate
  }

  class PersonaHumana extends Donante {
    nombre: String
    apellido: String
    fechaNacimiento: LocalDate
    dni : String
    genero: String
    direccion: String
  }

  class PersonaJuridica extends Donante{
    razonSocial: String
    rubro: String
    tipo: TipoOrganizacion
    cuit : String
    representantes: List<Representante>
  }

  class Representante {
    nombre: String
    apellido: String
    correo : MedioContacto
  }

  class RegistroDonacion {
    id : Long
    donante : Donante
    descripcion : String
    fecha : LocalDateTime
    donaciones : List<Donacion>
    agregarDonacion(donacion : Donacion) : void
    getBienes() : List<Bien>
  }

  class SegmentadorDeDonacion {
    segmentarDonacion(registroDonacion : RegistroDonacion, bienes : List<Bien>) : List<Donacion>
  }

  class Donacion {
    id : Long
    registroDonacion : RegistroDonacion
    donante : Donante
    entidadBeneficiariaAsignada : EntidadBeneficiaria
    necesidad : Necesidad
    subcategoria : Subcategoria
    estadoBienes : EstadoBien
    fechaVencimiento : LocalDate
    bienes : List<Bien>
    fecha : LocalDateTime
    estadoActual : TipoEstadoDonacion
    historialEstados : List<CambioEstado>
    fotosRecepcion : List<String>
    agregarBien(bien : Bien) : void
    estadoActual() : TipoEstadoDonacion
    cambiarEstado(nuevoEstado : TipoEstadoDonacion, justificacion : String) : void
    asignarA(entidad : EntidadBeneficiaria, necesidad : Necesidad) : void
    volverADeposito(justificacion : String) : void
    reprogramarEntrega(justificacion : String) : void
    confirmarEntrega(patenteCamion : String, fechaEntrega : LocalDateTime) : void
    confirmarRecepcion(fotos : List<String>) : void
    recepcionConfirmada() : boolean
    fechaDelEstadoActual() : LocalDateTime
    justificacionDelEstadoActual() : String
    fechaAsignacion() : LocalDateTime
    patenteCamionDeLaEntrega() : String
    cantidadBienesRecibidos(unidad : UnidadDeMedida) : Double
    estaDentroDelPeriodoActual(periodo : Periodo) : Boolean
    calcularPesoTotal() : Double
    calcularVolumenTotal() : Double
    obtenerDireccion() : String
  }

  class CambioEstado {
    fecha : LocalDateTime
    estado : TipoEstadoDonacion
    justificacion : String
    patenteCamion : String
  }

  class Categoria {
    id : Long
    nombre: String
    pideEstado: Boolean
    esPerecedero: Boolean
  }

  class Subcategoria {
    id : Long
    nombre: String
    categoria : Categoria
    esPerecedero() : Boolean
    pideEstado() : Boolean
  }

  class Bien {
    descripcion : String
    foto : String
    cantidad : Long
    pesoKgPorUnidad : Double
    volumenM3PorUnidad : Double
    subcategoria : Subcategoria
    estadoBien : EstadoBien
    fechaVencimiento : LocalDate
    generarKey() : String
    calcularPesoTotal() : Double
    calcularVolumenTotal() : Double
  }

  class EntidadBeneficiaria {
    id : Long
    razonSocial : String
    direccion : String
    latitud : Double
    longitud : Double
    telefono : MedioContacto
    correoRepresentantes : List<MedioContacto>
    necesidades : List<Necesidad>
    mudarseA(direccion : String) : void
    ubicarEn(latitud : double, longitud : double) : void
    estaUbicada() : boolean
    necesita(subcategoria : Subcategoria) : boolean
    registrarNecesidad(necesidad : Necesidad) : void
    confirmarEntrega(donacion : Donacion, patenteCamion : String, fechaEntrega : LocalDateTime) : void
    eliminarNecesidad(necesidadId : Long) : void
  }

  class Necesidad {
    id : Long
    subcategoria : Subcategoria
    tipoNecesidad : TipoNecesidad
    descripcion : String
    cantidad : Long
    unidad : UnidadDeMedida
    donacionesAsignadas : List<Donacion>
    cantidadAsignada() : Double
    estaSatisfecha() : Boolean
    donacionesEnCurso() : long
    asignarDonacion(donacion : Donacion) : void
    liberarDonacion(donacion : Donacion) : void
    liberarDonaciones() : void
  }

  interface TipoNecesidad {
    cantidadAsignada(donaciones : List<Donacion>, unidad : UnidadDeMedida) : Double
    estaSatisfecha(donaciones : List<Donacion>, cantidadRequerida : Long, unidad : UnidadDeMedida) : Boolean
  }

  class NecesidadExtraordinaria implements TipoNecesidad {
    cantidadAsignada(donaciones : List<Donacion>, unidad : UnidadDeMedida) : Double
  }

  class NecesidadRecurrente implements TipoNecesidad {
    periodo : Periodo
    cantidadAsignada(donaciones : List<Donacion>, unidad : UnidadDeMedida) : Double
  }

  class EventManagerDonaciones {
    listeners: Map<EventoDonaciones, ListenerDonaciones>
    registrarListener(claseEvento: Class, listener: ListenerDonaciones) : void
    desregistrarListener(claseEvento: Class, listener: ListenerDonaciones) : void
    emitir(evento: EventoDonaciones) : void
  }

  class GestorDeEventos {
    notificarAusenciaDonante(donante: Donante): void
    verificarInactividadDonantes(): void
    verificarInactividadDiaria(): void
    iniciarRuta(request: InicioRutaRequest): void
    emitirEntregaExitosa(entidad: EntidadBeneficiaria, donaciones: List<Donacion>, patente: String, fechaHora: LocalDateTime): void
    notificarEntregaFallida(donacionId: Long, motivo: String): void
    emitirRecepcionConfirmada(donacion: Donacion): void
  }

  interface EventoDonaciones {
  }

  class EventoAusenciaPlataforma implements EventoDonaciones {
    donante : Donante
  }

  class EventoDonacionAsignada implements EventoDonaciones {
    donacion : Donacion
    donante : Donante
    entidad : EntidadBeneficiaria
  }

  class EventoEntregaExitosa implements EventoDonaciones {
    entidad : EntidadBeneficiaria
    donaciones : List<Donacion>
    comprobante : ComprobanteEntrega
  }

  class EventoEntregaFallida implements EventoDonaciones {
    donacion : Donacion
    motivo : String
  }

  class EventoRecepcionConfirmada implements EventoDonaciones {
    donacion : Donacion
    donante : Donante
    entidad : EntidadBeneficiaria
  }

  interface ListenerDonaciones {
    ejecutar(evento: T) : void
  }

  class AusenciaPlataformaListener implements ListenerDonaciones {
    register() : void
    ejecutar(evento: EventoAusenciaPlataforma) : void
  }

  class DonacionAsignadaListener implements ListenerDonaciones {
    register() : void
    ejecutar(evento: EventoDonacionAsignada) : void
  }

  class EntregaExitosaListener implements ListenerDonaciones {
    register() : void
    ejecutar(evento: EventoEntregaExitosa) : void
  }

  class EntregaFallidaListener implements ListenerDonaciones {
    register() : void
    ejecutar(evento: EventoEntregaFallida) : void
  }

  class RecepcionConfirmadaListener implements ListenerDonaciones {
    register() : void
    ejecutar(evento: EventoRecepcionConfirmada) : void
  }

  interface AlgoritmoAsignacion {
    generarRanking(donacion: Donacion, entidadesCandidatas: List<EntidadBeneficiaria>): List<EntidadBeneficiaria>
  }

  class CompatibilidadSemantica implements AlgoritmoAsignacion {
    generarRanking(donacion: Donacion, entidadesCandidatas: List<EntidadBeneficiaria>): List<EntidadBeneficiaria>
  }

  class PrioridadSubAtendidos implements AlgoritmoAsignacion {
    generarRanking(donacion: Donacion, entidadesCandidatas: List<EntidadBeneficiaria>): List<EntidadBeneficiaria>
  }

  class MotorDeMatchmaking {
    algoritmos: List<AlgoritmoAsignacion>
    obtenerPropuestasPendientes(): List<PropuestaMatchmakingResponse>
    procesarMatchmaking(): void
    aceptarPropuesta(propuestaId: Long, entidadId: Long): void
    rechazarPropuesta(propuestaId: Long): void
    actualizarEstadoPropuesta(id: Long, request: EstadoPropuestaRequest): void
  }

  class ResultadoMatchmaking {
    id: Long
    donacion: Donacion
    entidadesSugeridas: List<EntidadBeneficiaria>
    fechaEjecucion: LocalDateTime
    estado: EstadoPropuesta
  }

  class ComprobanteEntrega {
    patenteCamion: String
    fechaHora: LocalDateTime
  }

  ' La importacion corre en segundo plano: el administrador ve el avance de cada tarea
  class ImportadorDeDonantes {
    tareas : List<ImportacionTarea>
    iniciarImportacion(archivo: InputStream, nombreArchivo: String): ImportacionTarea
    obtenerImportaciones(): List<ImportacionTarea>
    obtenerImportacion(id: String): Optional<ImportacionTarea>
    importarDonantes(pathArchivo: String): void
  }

  class ImportacionTarea {
    id : String
    nombreArchivo : String
    fecha : String
    estado : String
    totalFilas : int
    procesadas : int
    creados : int
    actualizados : int
    descartadas : int
    errores : List<FilaErrorDto>
    agregarError(error: FilaErrorDto): void
  }

  ' Crea el usuario de un donante cargado por el administrador (CSV o recepcion) y le manda su clave
  class AccesoInicialDonante {
    otorgar(donanteId: Long, nombre: String, email: String, donanteNuevo: boolean): void
  }

  interface Geocodificador {
    ubicar(direccion: String): Coordenadas
  }

  ' Valida y ubica direcciones con la API Georef (apis.datos.gob.ar)
  class GeorefGeocodificador implements Geocodificador {
    url : String
    ubicar(direccion: String): Coordenadas
  }

  class Coordenadas <<record>> {
    latitud : double
    longitud : double
    normalizada : String
  }

  ' Servidor gRPC al que llama logistica-service (TPA 4)
  class DonacionesGrpcServiceImpl {
    listarDonacionesPorEstado(...)
    actualizarEstadoDonacion(...)
    confirmarEntregaDonaciones(...)
    obtenerContactosEntidad(...)
    obtenerDonacion(...)
    obtenerContactoDonante(...)
  }

  enum TipoEstadoDonacion {
    EN_DEPOSITO
    ASIGNACION_REALIZADA
    LISTA_PARA_ENTREGAR
    EN_TRASLADO
    ENTREGADA
    ENTREGA_FALLIDA
    VENCIDA
    --
    estaEnCurso() : boolean
  }

  enum TipoOrganizacion {
    GUBERNAMENTAL
    ONG
    EMPRESA
    INSTITUCION
  }

  enum EstadoBien {
    NUEVO
    USADO
  }

  enum Periodo {
    DIARIO
    SEMANAL
    MENSUAL
    ANUAL
  }

  enum UnidadDeMedida {
    UNIDADES
    KILOGRAMOS
    LITROS
    cantidadDe(bien : Bien) : double
    {static} redondear(cantidad : double) : double
  }

  enum EstadoPropuesta {
    PENDIENTE
    ACEPTADO
    RECHAZADO
  }

  ' Credenciales de la plataforma web. El perfil se referencia por id segun el rol:
  ' Donante, EntidadBeneficiaria o, para el CHOFER, el Camion de logistica-service
  class Usuario {
    id : Long
    username : String
    passwordHash : String
    rol : Rol
    perfilId : Long
    activo : boolean
    {static} normalizar(username: String): String
    comoAutenticado(): UsuarioAutenticado
  }
}

package "Microservicio Logistica" {

  class Camion {
    id: Long
    patente: String
    capacidadVolumen: Double
    altura: Double
    capacidadCarga: Double
    chofer: Chofer
    ubicacion: Ubicacion
    actualizarUbicacion(nuevaUbicacion: Ubicacion)
  }

  class Chofer {
    nombre: String
    apellido: String
  }

  class Ruta {
    id: Long
    fecha: LocalDate
    estado: EstadoRuta
    camion: Camion
    chofer: Chofer
    paradas: List<Parada>
    iniciar()
    finalizar()
    todasLasParadasResueltas(): boolean
  }

  class Ubicacion {
    latitud: Double
    longitud: Double
    timestamp: LocalDateTime
    velocidad: Double
  }

  class Parada {
    id: Long
    orden: Integer
    destino: String
    entidadId: Long
    latitud: Double
    longitud: Double
    estado: EstadoParada
    donacionIds: List<Long>
    coordenadas(): double[]
    marcarEntregada()
    marcarNoRecibida()
  }

  ' Adaptador hacia el componente externo de planificacion de rutas: le manda las donaciones
  ' (lotes de hasta 100) y los camiones, y el resultado vuelve por callback REST.
  ' En la entrega el componente se simula: calcularPlanificacion reparte por peso y volumen.
  class GestorPlanificacionRutas {
    solicitarPlanificacion(donaciones : List<DonacionDTO>, camiones : List<Camion>) : void
    calcularPlanificacion(donaciones : List<DonacionDTO>, camiones : List<Camion>) : EjecutarPlanificacionRequest
  }

  ' Ubicacion de respaldo de una parada cuando la entidad no tiene coordenadas
  class GeocodificadorCaba <<utility>> {
    {static} ubicar(direccion : String, entidadId : Long) : double[]
  }

  ' Cliente gRPC hacia donaciones-service (x-api-key en metadata)
  class DonacionesGrpcClient {
    listarPorEstado(estado : String, limit : int, offset : int) : List<DonacionDTO>
    actualizarEstado(donacionId : Long, nuevoEstado : String, justificacion : String) : void
    confirmarEntrega(entidadId : Long, donacionesIds : List<Long>, patente : String, fechaHora : LocalDateTime) : void
    obtenerContactosEntidad(entidadId : Long) : List<MedioContacto>
    obtenerDonacion(donacionId : Long) : DonacionResponse
    obtenerContactoDonante(donanteId : Long) : MedioContacto
  }

  class GestorDeRutas {
    iniciarRuta(ruta : Ruta) : void
    confirmarEntregaExitosa(parada : Parada, ruta : Ruta) : void
    registrarEntregaFallida(parada : Parada, motivo : String) : void
  }

  class PlanificadorDeRutas {
    planificarRutas() : void
    ejecutarPlanificacion(request: EjecutarPlanificacionRequest) : void
  }

  class MonitorDeRutas {
    actualizarUbicacionCamion(patente : String, request : UbicacionRequest) : void
    obtenerUltimaUbicacionPorRuta(rutaId : Long) : UbicacionResponse
    obtenerCamionesActivos() : List<CamionActivoResponse>
  }

  enum EstadoRuta {
    PLANIFICADA
    EN_TRASLADO
    FINALIZADA
  }

  enum EstadoParada {
    PENDIENTE
    ENTREGADA
    NO_RECIBIDA
  }

  interface EventoLogistica {
  }

  interface ListenerLogistica {
    ejecutar(evento: T) : void
  }

  class EventManagerLogistica {
    listeners: Map<EventoLogistica, ListenerLogistica>
    registrarListener(claseEvento: Class, listener: ListenerLogistica) : void
    desregistrarListener(claseEvento: Class, listener: ListenerLogistica) : void
    emitir(evento: EventoLogistica) : void
  }

  class EventoInicioRuta implements EventoLogistica {
    ruta: Ruta
    mapaUrl: String
  }

  class InicioRutaListener implements ListenerLogistica {
    registerListeners() : void
    ejecutar(evento: EventoInicioRuta) : void
  }
}

Notificacion --> MedioContacto
MedioContacto --> TipoContacto
Notificador --> "*" EstrategiaNotificacion
Notificador ..> Notificacion

Donante --> "*" RegistroDonacion
Donante --> "*" MedioContacto
PersonaJuridica --> "*" Representante
PersonaJuridica --> TipoOrganizacion
Representante --> MedioContacto

RegistroDonacion --> Donante
RegistroDonacion --> "1..*" Donacion
Donacion --> RegistroDonacion
Donacion --> Donante
Donacion --> EntidadBeneficiaria
Donacion --> Necesidad
Donacion --> Subcategoria
Donacion --> "*" CambioEstado
Donacion --> "*" Bien
Donacion --> EstadoBien
Donacion --> TipoEstadoDonacion
CambioEstado --> TipoEstadoDonacion

Subcategoria --> Categoria
Bien --> Subcategoria
Bien --> EstadoBien

EntidadBeneficiaria --> "*" MedioContacto
EntidadBeneficiaria --> "*" Necesidad

Necesidad --> Subcategoria
Necesidad --> TipoNecesidad
Necesidad --> "*" Donacion
NecesidadRecurrente --> Periodo
Necesidad --> UnidadDeMedida
UnidadDeMedida ..> Bien

EventManagerDonaciones --> "*" ListenerDonaciones

EventoEntregaExitosa --> ComprobanteEntrega

MotorDeMatchmaking --> "*" AlgoritmoAsignacion
ResultadoMatchmaking --> Donacion
ResultadoMatchmaking --> "*" EntidadBeneficiaria
ResultadoMatchmaking --> EstadoPropuesta

Camion --> Chofer
Ruta --> EstadoRuta
Ruta --> Camion
Ruta --> "*" Parada
Ruta --> Chofer
Parada --> EstadoParada
Camion --> Ubicacion

EntidadBeneficiaria ..> Donacion

TipoNecesidad ..> Donacion
NecesidadExtraordinaria ..> Donacion
NecesidadRecurrente ..> Donacion

EventManagerDonaciones ..> EventoDonaciones
ListenerDonaciones ..> EventoDonaciones

AusenciaPlataformaListener ..> EventoAusenciaPlataforma
DonacionAsignadaListener ..> EventoDonacionAsignada
EntregaExitosaListener ..> EventoEntregaExitosa
EntregaFallidaListener ..> EventoEntregaFallida

EventoAusenciaPlataforma --> Donante
EventoDonacionAsignada --> Donante
EventoDonacionAsignada --> EntidadBeneficiaria
EventoEntregaExitosa --> EntidadBeneficiaria
EventoEntregaExitosa --> "*" Donacion
EventoEntregaFallida --> Donacion
EventoDonacionAsignada --> Donacion
EventoRecepcionConfirmada --> Donacion
EventoRecepcionConfirmada --> Donante
EventoRecepcionConfirmada --> EntidadBeneficiaria
RecepcionConfirmadaListener ..> EventoRecepcionConfirmada

EventManagerLogistica --> "*" ListenerLogistica
EventManagerLogistica ..> EventoLogistica
ListenerLogistica ..> EventoLogistica
EventoInicioRuta --> Ruta
InicioRutaListener ..> EventoInicioRuta
InicioRutaListener ..> EventManagerLogistica

AlgoritmoAsignacion ..> Donacion
AlgoritmoAsignacion ..> EntidadBeneficiaria
CompatibilidadSemantica ..> Donacion
CompatibilidadSemantica ..> EntidadBeneficiaria
PrioridadSubAtendidos ..> Donacion
PrioridadSubAtendidos ..> EntidadBeneficiaria

MotorDeMatchmaking ..> Donacion
MotorDeMatchmaking ..> EntidadBeneficiaria
MotorDeMatchmaking ..> ResultadoMatchmaking

GestorPlanificacionRutas ..> Camion
GestorDeRutas ..> Ruta
GestorDeRutas ..> Parada
GestorDeRutas ..> EventManagerLogistica
PlanificadorDeRutas ..> GestorPlanificacionRutas
PlanificadorDeRutas --> DonacionesGrpcClient
GestorDeRutas --> DonacionesGrpcClient
InicioRutaListener --> DonacionesGrpcClient
GestorPlanificacionRutas ..> GeocodificadorCaba
PlanificadorDeRutas ..> Camion
MonitorDeRutas ..> Camion
MonitorDeRutas ..> Ruta
MonitorDeRutas ..> Ubicacion

EventManagerDonaciones ..> ListenerDonaciones
GestorDeEventos ..> Donante
GestorDeEventos ..> Donacion
GestorDeEventos ..> EntidadBeneficiaria
GestorDeEventos ..> EventManagerDonaciones

SegmentadorDeDonacion ..> Donacion
SegmentadorDeDonacion ..> RegistroDonacion
SegmentadorDeDonacion ..> Bien

ImportadorDeDonantes ..> Donante
ImportadorDeDonantes --> "*" ImportacionTarea
ImportadorDeDonantes --> AccesoInicialDonante
AccesoInicialDonante ..> Usuario
GeorefGeocodificador ..> Coordenadas
EntidadBeneficiaria ..> Geocodificador : ubicada al registrarse
DonacionesGrpcServiceImpl ..> Donacion
DonacionesGrpcServiceImpl ..> EntidadBeneficiaria
DonacionesGrpcClient ..> DonacionesGrpcServiceImpl : gRPC / HTTP2

Usuario --> Rol
Usuario ..> Donante : perfilId
Usuario ..> EntidadBeneficiaria : perfilId
Usuario ..> Camion : perfilId (CHOFER)

Email --> ProveedorEmail
SMS --> ProveedorSMS
WhatsApp --> ProveedorWhatsapp

@enduml