            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "\"EN_TRASLADO\""
            },
            "url": {
              "raw": "{{logistica_url}}/rutas/1/estado",
              "host": ["{{logistica_url}}"],
              "path": ["rutas", "1", "estado"]
            }
          }
        },
        {
          "name": "Telemetría GPS en Tiempo Real",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitud\": -34.6037,\n  \"longitud\": -58.3816,\n  \"velocidad\": 45.5\n}"
            },
            "url": {
              "raw": "{{logistica_url}}/camiones/ubicacion/AB123CD",
              "host": ["{{logistica_url}}"],
              "path": ["camiones", "ubicacion", "AB123CD"]
            }
          }
        },
        {
          "name": "Confirmar Entrega de Parada (ENTREGADA)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{logistica_url}}/rutas/1/paradas/1/confirmaciones",
              "host": ["{{logistica_url}}"],
              "path": ["rutas", "1", "paradas", "1", "confirmaciones"]
            }
          }
        }
      ]
    },
    {
      "name": "07 - Notificaciones (TPA 2)",
      "item": [
        {
          "name": "Enviar Notificación",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacto\": {\n    \"tipoContacto\": \"EMAIL\",\n    \"direccion\": \"ana.perez@mail.com\"\n  },\n  \"mensaje\": \"¡Tu donación de Fideos Secos ha sido entregada exitosamente al Comedor Escobar!\"\n}"
            },
            "url": {
              "raw": "{{notificaciones_url}}/notificaciones",
              "host": ["{{notificaciones_url}}"],
              "path": ["notificaciones"]
            }
          }
        }
      ]
    }
  ]
}
