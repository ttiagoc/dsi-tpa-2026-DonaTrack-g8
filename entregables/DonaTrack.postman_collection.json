    },
    {
      "name": "05 - Matchmaking (TPA 2)",
      "item": [
        {
          "name": "Disparar Algoritmos de Matchmaking",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{donaciones_url}}/matchmaking/ejecuciones",
              "host": ["{{donaciones_url}}"],
              "path": ["matchmaking", "ejecuciones"]
            }
          }
        },
        {
          "name": "Ver Propuestas de Asignación Pendientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{donaciones_url}}/matchmaking/pendientes",
              "host": ["{{donaciones_url}}"],
              "path": ["matchmaking", "pendientes"]
            }
          }
        },
        {
          "name": "Aceptar Propuesta (Donación -> ASIGNACION_REALIZADA)",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ACEPTADO\",\n  \"entidadId\": 1\n}"
            },
            "url": {
              "raw": "{{donaciones_url}}/matchmaking/propuestas/1/estado",
              "host": ["{{donaciones_url}}"],
              "path": ["matchmaking", "propuestas", "1", "estado"]
            }
          }
        }
      ]
    },
    {
      "name": "06 - Logística (TPA 2)",
      "item": [
        {
          "name": "Registrar Camión en la Flota",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patente\": \"AB123CD\",\n  \"capacidadVolumen\": 30.0,\n  \"altura\": 3.8,\n  \"capacidadCarga\": 8000.0,\n  \"chofer\": {\n    \"nombre\": \"Esteban\",\n    \"apellido\": \"Quito\"\n  }\n}"
            },
            "url": {
              "raw": "{{logistica_url}}/camiones",
              "host": ["{{logistica_url}}"],
              "path": ["camiones"]
            }
          }
        },
