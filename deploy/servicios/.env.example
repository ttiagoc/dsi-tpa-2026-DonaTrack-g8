# Copiar a deploy/servicios/.env (no se versiona) y completar.

# Nombre DNS de la VM de servicios: Caddy saca el certificado HTTPS para este nombre
DOMINIO=donatrack-g8.chilecentral.cloudapp.azure.com

# Base de datos (Azure Database for PostgreSQL o la VM de base de datos), con las bases
# donaciones, logistica y notificaciones creadas
DB_HOST=donatrack-g8-db.postgres.database.azure.com
DB_USUARIO=donatrack
DB_PASSWORD=
# require para Azure Database for PostgreSQL; disable si la base es un PostgreSQL propio sin TLS en la VNet
DB_SSLMODE=require

# Iguales en todos los servicios. La SERVICE_API_KEY tambien va en la VM de cron
JWT_SECRET=
SERVICE_API_KEY=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAILS=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Carpeta de la VM donde esta montado el share de Azure Files con las fotos (montar-fotos.sh)
FOTOS_DIR_VM=/mnt/donatrack-fotos
