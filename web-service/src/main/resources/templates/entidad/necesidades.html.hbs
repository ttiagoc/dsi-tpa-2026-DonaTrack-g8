{{#partial "titulo"}}Necesidades · DonaTrack{{/partial}}
{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Necesidades</h1>
    <p class="texto-suave">Lo que necesita tu entidad. Las donaciones se asignan según estas necesidades.</p>
  </div>
  <a class="boton" href="/entidad/necesidades?nueva" data-abre="modal-alta">+ Nueva necesidad</a>
</header>

{{#if necesidades}}
  <div class="resumen">
    <div class="resumen__item"><strong>{{resumen.total}}</strong>Necesidades</div>
    <div class="resumen__item resumen__item--pendiente"><strong>{{resumen.pendientes}}</strong>Pendientes</div>
    <div class="resumen__item resumen__item--ok"><strong>{{resumen.cubiertas}}</strong>Cubiertas</div>
  </div>

  <section class="tarjeta tarjeta--tabla">
    <div class="tabla-contenedor">
      <table class="tabla">
        <caption class="sr-only">Necesidades solicitadas por la entidad</caption>
        <thead>
          <tr>
            <th scope="col">Subcategoría</th>
            <th scope="col">Descripción</th>
            <th scope="col">Frecuencia</th>
            <th scope="col">Asignado</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each necesidades}}
            <tr>
              <td class="tabla__corta">{{subcategoria}}{{#if categoria}}<span class="tabla__secundario">{{categoria}}</span>{{/if}}</td>
              <td>{{descripcion}}</td>
              <td class="tabla__corta">{{frecuencia}}</td>
              <td>
                <div class="progreso">
                  <span>{{cantidadAsignada}} de {{cantidad}} {{unidad}}</span>
                  <div class="progreso__barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{porcentaje}}" aria-label="Cobertura de {{subcategoria}}: {{cantidadAsignada}} de {{cantidad}} {{unidad}}"><span style="width: {{porcentaje}}%"></span></div>
                </div>
              </td>
              <td>
                {{#if satisfecha}}<span class="etiqueta">Cubierta</span>{{else}}<span class="etiqueta etiqueta--pendiente">Pendiente</span>{{/if}}
              </td>
              <td class="tabla__accion">
                <form method="post" action="/entidad/necesidades/{{id}}/eliminar" data-confirmar
                      data-nombre="{{subcategoria}}" data-detalle="{{frecuencia}} · {{cantidad}} {{unidad}}"
                      data-en-curso="{{donacionesEnCurso}}">
                  <button type="submit" class="boton boton--secundario boton--peligro boton--chico">Eliminar <span class="sr-only">necesidad de {{subcategoria}}</span></button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  <p class="nota">"Asignado" suma las donaciones ya asignadas a la necesidad (en las que se repiten, solo las del período actual). En kilogramos o litros se usa el peso o el volumen de cada bien; si un bien no lo tiene cargado, no suma.</p>
{{else}}
  <section class="tarjeta vacio">
    <strong>Todavía no cargaste necesidades.</strong>
    Con el botón “Nueva necesidad” contás qué le hace falta a tu entidad.
  </section>
{{/if}}

{{!-- Alta. Si el servidor rechaza los datos, la pagina vuelve con el modal abierto ("open"), los errores y lo cargado --}}
<dialog class="modal" id="modal-alta" aria-labelledby="titulo-alta" {{#if abrirAlta}}open{{/if}}>
  <form method="post" action="/entidad/necesidades" accept-charset="UTF-8" novalidate>
    <div class="modal__encabezado">
      <h2 id="titulo-alta">Nueva necesidad</h2>
      <a class="modal__cerrar" href="/entidad/necesidades" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></a>
    </div>
    <div class="modal__cuerpo">
      {{#if errorAlta}}<div class="alerta alerta--error" role="alert">{{errorAlta}}</div>{{/if}}
      <div class="campo{{#if errores.subcategoria}} campo--error{{/if}}">
        <label for="subcategoria">Subcategoría <span class="campo__requerido" aria-hidden="true">*</span></label>
        <select id="subcategoria" name="subcategoria" required autofocus data-buscador="Buscá o elegí una subcategoría">
          <option value="">Elegí una subcategoría</option>
          {{#each rubros}}
            <optgroup label="{{categoria}}">
              {{#each subcategorias}}
                <option {{#if (eq this @root.form.subcategoria)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </optgroup>
          {{/each}}
        </select>
        {{#if errores.subcategoria}}<small class="campo__error">{{errores.subcategoria}}</small>{{/if}}
      </div>
      <div class="campo{{#if errores.frecuencia}} campo--error{{/if}}">
          <label for="frecuencia">¿Cada cuánto la necesitan? <span class="campo__requerido" aria-hidden="true">*</span></label>
          <select id="frecuencia" name="frecuencia" required>
            <option value="">Elegí una opción</option>
            {{#each frecuencias}}
              <option value="{{valor}}" {{#if (eq valor @root.form.frecuencia)}}selected{{/if}}>{{etiqueta}}</option>
            {{/each}}
          </select>
          {{#if errores.frecuencia}}<small class="campo__error">{{errores.frecuencia}}</small>{{/if}}
      </div>
      {{!-- cantidad y su unidad van juntas: "50" + "kilogramos" --}}
      <div class="grilla grilla--2">
        {{> partials/campo nombre="cantidad" etiqueta="Cantidad" tipo="number" valor=form.cantidad errorCampo=errores.cantidad requerido=true min="1"}}
        <div class="campo{{#if errores.unidad}} campo--error{{/if}}">
          <label for="unidad">¿En qué se mide? <span class="campo__requerido" aria-hidden="true">*</span></label>
          <select id="unidad" name="unidad" required>
            {{#each unidades}}
              <option value="{{valor}}" {{#if (eq valor @root.form.unidad)}}selected{{/if}}>{{etiqueta}}</option>
            {{/each}}
          </select>
          {{#if errores.unidad}}<small class="campo__error">{{errores.unidad}}</small>{{/if}}
        </div>
      </div>
      <p class="nota">Las donaciones se cuentan por unidad. Si pedís kilogramos o litros, se suman con el peso o el volumen de cada bien donado (por ejemplo, 20 paquetes de 500 g son 10 kg).</p>
      <div class="campo{{#if errores.descripcion}} campo--error{{/if}}">
        <label for="descripcion">Descripción <span class="campo__requerido" aria-hidden="true">*</span></label>
        <textarea id="descripcion" name="descripcion" maxlength="500" required>{{form.descripcion}}</textarea>
        {{#if errores.descripcion}}<small class="campo__error">{{errores.descripcion}}</small>{{/if}}
      </div>
    </div>
    <div class="modal__acciones">
      <a class="boton boton--secundario" href="/entidad/necesidades" data-cierra>Cancelar</a>
      <button type="submit" class="boton">Guardar necesidad</button>
    </div>
  </form>
</dialog>

{{!-- Confirmacion antes de eliminar: la arma el script con los datos de la fila --}}
<dialog class="modal modal--chico" id="modal-eliminar" aria-labelledby="titulo-eliminar">
  <form method="post">
    <div class="modal__encabezado">
      <h2 id="titulo-eliminar">¿Eliminar la necesidad?</h2>
      <button type="button" class="modal__cerrar" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></button>
    </div>
    <div class="modal__cuerpo">
      <p><strong data-nombre></strong> · <span data-detalle></span></p>
      <p class="texto-suave">Las donaciones que ya llegaron siguen apareciendo en Donaciones asignadas. Esta acción no se puede deshacer.</p>
    </div>
    <div class="modal__acciones">
      <button type="button" class="boton boton--secundario" data-cierra autofocus>Cancelar</button>
      <button type="submit" class="boton boton--peligro">Eliminar</button>
    </div>
  </form>
</dialog>

{{!-- En lugar de la confirmacion, si la necesidad tiene donaciones en camino (la API tambien lo rechaza) --}}
<dialog class="modal modal--chico" id="modal-no-eliminar" aria-labelledby="titulo-no-eliminar">
  <div class="modal__encabezado">
    <h2 id="titulo-no-eliminar">No se puede eliminar la necesidad</h2>
    <button type="button" class="modal__cerrar" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></button>
  </div>
  <div class="modal__cuerpo">
    <p><strong data-nombre></strong> · <span data-detalle></span></p>
    <p class="texto-suave">Tiene <span data-en-curso></span> que todavía no <span data-llegaron></span>. Vas a poder eliminarla cuando se entreguen. Podés ver su estado en <a href="/entidad/donaciones">Donaciones asignadas</a>.</p>
  </div>
  <div class="modal__acciones">
    <button type="button" class="boton" data-cierra autofocus>Entendido</button>
  </div>
</dialog>
{{/partial}}
{{#partial "scripts"}}
<script>
  // Sin JavaScript igual funciona: "Nueva" abre el modal con ?nueva y "Eliminar" borra sin confirmar.
  (function () {
    var alta = document.getElementById('modal-alta');
    var eliminar = document.getElementById('modal-eliminar');
    var noEliminar = document.getElementById('modal-no-eliminar');
    if (!alta.showModal) return;

    if (alta.hasAttribute('open')) { alta.close(); alta.showModal(); }

    document.querySelectorAll('[data-abre]').forEach(function (boton) {
      boton.addEventListener('click', function (e) {
        e.preventDefault();
        document.getElementById(boton.dataset.abre).showModal();
      });
    });
    document.querySelectorAll('[data-cierra]').forEach(function (boton) {
      boton.addEventListener('click', function (e) {
        e.preventDefault();
        boton.closest('dialog').close();
      });
    });
    document.querySelectorAll('form[data-confirmar]').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var enCurso = Number(form.dataset.enCurso) || 0;
        var modal = enCurso > 0 ? noEliminar : eliminar;
        modal.querySelector('[data-nombre]').textContent = form.dataset.nombre;
        modal.querySelector('[data-detalle]').textContent = form.dataset.detalle;
        if (enCurso > 0) {
          modal.querySelector('[data-en-curso]').textContent = enCurso === 1
            ? '1 donación asignada' : enCurso + ' donaciones asignadas';
          modal.querySelector('[data-llegaron]').textContent = enCurso === 1 ? 'llegó' : 'llegaron';
        } else {
          eliminar.querySelector('form').action = form.action;
        }
        modal.showModal();
      });
    });
  })();
</script>
{{/partial}}
{{> layouts/base}}
