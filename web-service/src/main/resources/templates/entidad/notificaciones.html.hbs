{{#partial "titulo"}}Notificaciones · DonaTrack{{/partial}}

{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Notificaciones</h1>
    <p class="texto-suave">Avisos sobre el estado de tus donaciones, entregas y logros.</p>
  </div>
</header>

{{#if notificaciones}}
  <section class="tarjeta tarjeta--tabla">
    <div class="tabla-contenedor">
      <table class="tabla">
        <caption class="sr-only">Historial de notificaciones de la entidad</caption>
        <thead>
          <tr>
            <th scope="col">Aviso</th>
            <th scope="col" class="tabla__corta" style="text-align: right;">Fecha</th>
          </tr>
        </thead>
        <tbody>
          {{#each notificaciones}}
            <tr>
              <td>
                <div style="display: flex; gap: var(--espacio-3); align-items: flex-start;">
                  <span style="font-size: 1.25rem; line-height: 1;" aria-hidden="true">🔔</span>
                  <div>
                    <div><strong>{{this.mensaje}}</strong></div>
                    {{#if this.tipoEvento}}
                      <span class="tabla__secundario">{{this.tipoEvento}}</span>
                    {{/if}}
                  </div>
                </div>
              </td>
              <td class="tabla__corta tabla__secundario" style="text-align: right; vertical-align: top;">
                {{this.fechaFormateada}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{else}}
  <section class="tarjeta vacio">
    <strong>Bandeja al día.</strong>
    No tenés notificaciones pendientes en este momento.
  </section>
{{/if}}
{{/partial}}

{{> layouts/base}}