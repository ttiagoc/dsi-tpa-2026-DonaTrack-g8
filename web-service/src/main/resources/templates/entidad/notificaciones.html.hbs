{{#partial "titulo"}}Notificaciones · DonaTrack{{/partial}}

{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Notificaciones</h1>
    <p class="texto-suave">Avisos sobre el estado de tus donaciones, entregas y logros.</p>
  </div>
</header>

{{#if notificaciones}}
  <section class="tarjeta tarjeta--tabla">
    <div class="tabla-contenedor">
      <table class="tabla">
        <caption class="sr-only">Historial de notificaciones de la entidad</caption>
        <thead>
          <tr>
            <th scope="col">Aviso</th>
            <th scope="col" class="notificacion-item__fecha">Fecha</th>
          </tr>
        </thead>
        <tbody>
          {{#each notificaciones}}
            <tr>
              <td>
                <div class="notificacion-item">
                  <div class="notificacion-item__icono" aria-hidden="true">
                    <svg class="icono"><use href="#i-campana"/></svg>
                  </div>
                  <div class="notificacion-item__cuerpo">
                    <div class="notificacion-item__mensaje">{{this.mensajeLimpio}}</div>
                    <div class="notificacion-item__pie">
                      {{#if this.tipoEvento}}
                        <span class="etiqueta {{this.claseEtiqueta}}">{{this.eventoLegible}}</span>
                      {{/if}}
                      {{#if this.accionUrl}}
                        <a class="boton boton--chico boton--secundario" href="{{this.accionUrl}}">
                          <svg class="icono" aria-hidden="true"><use href="#i-mapa"/></svg> {{this.accionTexto}}
                        </a>
                      {{/if}}
                    </div>
                  </div>
                </div>
              </td>
              <td class="notificacion-item__fecha">
                {{this.fechaFormateada}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{> partials/paginacion}}
  </section>
{{else}}
  <section class="tarjeta vacio">
    <strong>Bandeja al día.</strong>
    No tenés notificaciones pendientes en este momento.
  </section>
{{/if}}
{{/partial}}

{{> layouts/base}}