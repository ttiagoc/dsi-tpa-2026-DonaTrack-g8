<form class="filtros" method="get" action="{{action}}" novalidate>
  {{> @partial-block}}
  <div class="filtros__acciones">
    {{#if botonTexto}}
      {{boton "confirmar" texto=botonTexto type="submit"}}
    {{else}}
      {{boton "confirmar" texto="Filtrar" type="submit"}}
    {{/if}}
    {{#if limpiarHref}}
      {{boton "cancelar" href=limpiarHref texto="Limpiar"}}
    {{/if}}
  </div>
</form>


