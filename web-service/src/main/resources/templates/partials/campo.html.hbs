{{!-- Uso: {{> partials/campo nombre="email" etiqueta="Email" tipo="email" valor=form.email errorCampo=errores.email requerido=true}}
      Opcionales: tipo (text por defecto), ayuda, autocomplete, requerido,
      min (numeros), minlength (textos) e igualA (nombre de otro campo que tiene que coincidir, ej. repetir contrasenia).
      tipo="email" y tipo="tel" ya se validan en el navegador (public/js/formularios.js) y en el servidor (Formulario). --}}
<div class="campo{{#if errorCampo}} campo--error{{/if}}">
  <label for="{{nombre}}">{{etiqueta}}{{#if requerido}} <span class="campo__requerido" aria-hidden="true">*</span>{{/if}}</label>
  <input id="{{nombre}}" name="{{nombre}}" type="{{#if tipo}}{{tipo}}{{else}}text{{/if}}" value="{{valor}}"
         {{#if requerido}}required{{/if}} {{#if autocomplete}}autocomplete="{{autocomplete}}"{{/if}}
         {{#if min}}min="{{min}}"{{/if}} {{#if minlength}}minlength="{{minlength}}"{{/if}} {{#if igualA}}data-igual-a="{{igualA}}"{{/if}}
         {{#if errorCampo}}aria-invalid="true" aria-describedby="{{nombre}}-error"{{else}}{{#if ayuda}}aria-describedby="{{nombre}}-ayuda"{{/if}}{{/if}}>
  {{#if ayuda}}<small class="campo__ayuda" id="{{nombre}}-ayuda">{{ayuda}}</small>{{/if}}
  {{#if errorCampo}}<small class="campo__error" id="{{nombre}}-error">{{errorCampo}}</small>{{/if}}
</div>
