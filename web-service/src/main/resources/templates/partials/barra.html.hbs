{{!-- Barra superior (con sesion): la hamburguesa del menu (solo en celular) y el perfil a la derecha.
      Sin titulo: el de cada pagina ya esta en su <h1>.
      El menu del perfil es un <details>: se abre y se cierra sin JavaScript. --}}
<header class="barra">
  <label for="menu-toggle" class="barra__boton barra__hamburguesa" aria-label="Abrir o cerrar el menú">
    <svg class="icono" aria-hidden="true"><use href="#i-menu"/></svg>
  </label>
  <details class="perfil">
    <summary class="perfil__boton">
      <span class="perfil__avatar" aria-hidden="true">{{usuario.iniciales}}</span>
      <span class="perfil__datos">
        <span class="perfil__nombre">{{usuario.username}}</span>
        <span class="perfil__rol">{{usuario.rolEtiqueta}}</span>
      </span>
      <svg class="icono" aria-hidden="true"><use href="#i-abajo"/></svg>
    </summary>
    <div class="perfil__menu">
      {{!-- Cada rol puede sumar aca "Datos de ..." cuando exista esa pantalla. --}}
      <form method="post" action="/logout">
        <button type="submit">Salir</button>
      </form>
    </div>
  </details>
</header>
