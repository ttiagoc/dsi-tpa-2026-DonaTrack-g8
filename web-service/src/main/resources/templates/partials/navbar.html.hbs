{{!-- Navbar de los visitantes (sin sesion). Con sesion se usan partials/menu-lateral y partials/barra.
      A la derecha las paginas publicas y, separado por una linea, lo de la cuenta (ingresar y registrarse). --}}
<header class="navbar">
  <div class="navbar__contenido">
    <a class="navbar__marca" href="/">
      <img src="/img/logo.svg" alt="" width="28" height="28"> DonaTrack
    </a>
    <input type="checkbox" id="navbar-toggle" class="navbar__toggle">
    <label for="navbar-toggle" class="navbar__hamburguesa" aria-label="Abrir o cerrar el menú">
      <span></span><span></span><span></span>
    </label>
    <nav class="navbar__links" aria-label="Principal">
      <a href="/mapa" {{#if (eq rutaActual "/mapa")}}aria-current="page"{{/if}}>Mapa de entregas</a>
    </nav>
    <div class="navbar__cuenta">
      <a href="/login" {{#if (eq rutaActual "/login")}}aria-current="page"{{/if}}>Ingresar</a>
      <a class="boton boton--chico" href="/registro" {{#if enRegistro}}aria-current="page"{{/if}}>Registrarme</a>
    </div>
  </div>
</header>
