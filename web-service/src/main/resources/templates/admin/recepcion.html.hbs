{{#partial "titulo"}}Recepción en Depósito · DonaTrack{{/partial}}
{{#partial "contenido"}}
{{> partials/encabezado
    titulo="Recepción de Donaciones en Depósito"
    bajada="Registrá el ingreso físico de donaciones y asociá donantes presenciales en el centro de acopio."
    accionHref="/admin/recepcion?nuevoDonante=true"
    accionTexto="Nuevo donante"
    accionModal="modal-donante"}}

<div class="resumen">
  <div class="resumen__item"><strong>{{totalDonantes}}</strong>Donantes registrados</div>
  <div class="resumen__item resumen__item--ok"><strong>{{resumen.ingresosMes}}</strong>Donaciones en depósito</div>
  <div class="resumen__item resumen__item--info"><strong>Depósito Central</strong>Ubicación operativa</div>
</div>

<section class="tarjeta">
  <form method="post" action="/admin/recepcion" novalidate>
    {{#if errorGeneral}}<div class="alerta alerta--error" role="alert">{{errorGeneral}}</div>{{/if}}

    <div class="seccion-form">
      <h2 class="seccion-form__titulo">1. Donante</h2>
      <div class="campo{{#if errores.donanteId}} campo--error{{/if}}">
        <label for="donanteId">Donante que entrega los bienes <span class="campo__requerido" aria-hidden="true">*</span></label>
        <select id="donanteId" name="donanteId" required data-buscador="Buscá por DNI, CUIT o nombre">
          <option value="">Seleccioná un donante...</option>
          {{#each donantes}}
            <option value="{{id}}" {{#if (eq ../form.donanteId idStr)}}selected{{/if}}>{{etiquetaBuscador}}</option>
          {{/each}}
        </select>
        {{#if errores.donanteId}}<small class="campo__error">{{errores.donanteId}}</small>{{/if}}
      </div>
    </div>

    <div class="seccion-form">
      <h2 class="seccion-form__titulo">2. Datos de la Entrega</h2>
      <div class="campo{{#if errores.descripcion}} campo--error{{/if}}">
        <label for="descripcion">Descripción general de la donación</label>
        <input type="text" id="descripcion" name="descripcion" value="{{form.descripcion}}">
        {{#if errores.descripcion}}<small class="campo__error">{{errores.descripcion}}</small>{{/if}}
      </div>
    </div>

    <div class="seccion-form">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--espacio-2);">
        <div>
          <h2 class="seccion-form__titulo" style="margin-bottom: var(--espacio-1);">3. Artículos / Bienes a Recibir</h2>
          <p class="texto-suave" style="margin: 0;">
            Podés cargar todos los artículos que entregue la persona. El sistema realizará la <strong>segmentación automática</strong> en donaciones independientes agrupadas por subcategoría, vencimiento y estado.
          </p>
        </div>
      </div>

      <div id="contenedor-bienes" style="margin-top: var(--espacio-3);">
        {{#if bienes}}
          {{#each bienes}}
            <div class="bien-item" data-indice="{{indice}}">
              <div class="bien-item__encabezado">
                <span class="bien-item__titulo">Artículo #{{indice}}</span>
                <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien">Quitar</button>
              </div>
              <div class="grilla grilla--3">
                <div class="campo{{#if ../errores.subcategoria}} campo--error{{/if}}">
                  <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <select name="subcategoria" required data-buscador="Buscá una subcategoría">
                    <option value="">Seleccioná subcategoría...</option>
                    {{#each ../catalogo}}
                      <optgroup label="{{nombre}}">
                        {{#each subcategorias}}
                          <option value="{{this}}" {{#if (eq ../../subcategoria this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </optgroup>
                    {{/each}}
                  </select>
                  {{#if ../errores.subcategoria}}<small class="campo__error">{{../errores.subcategoria}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.bienDescripcion}} campo--error{{/if}}">
                  <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="text" name="bienDescripcion" value="{{bienDescripcion}}" required placeholder="ej: Fideos secos x 500 g">
                  {{#if ../errores.bienDescripcion}}<small class="campo__error">{{../errores.bienDescripcion}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.cantidad}} campo--error{{/if}}">
                  <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="number" name="cantidad" value="{{cantidad}}" required min="1" placeholder="50">
                  {{#if ../errores.cantidad}}<small class="campo__error">{{../errores.cantidad}}</small>{{/if}}
                </div>
              </div>

              <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
                <div class="campo">
                  <label>Fecha de vencimiento (si aplica)</label>
                  <input type="date" name="fechaVencimiento" value="{{fechaVencimiento}}">
                </div>
                <div class="campo">
                  <label>Peso por unidad (kg)</label>
                  <input type="number" name="pesoKg" value="{{pesoKg}}" min="0.01" step="any" placeholder="1.0">
                </div>
                <div class="campo">
                  <label>Volumen por unidad (m³)</label>
                  <input type="number" name="volumenM3" value="{{volumenM3}}" min="0.0001" step="any" placeholder="0.001">
                </div>
                <div class="campo">
                  <label>Estado de los bienes</label>
                  <select name="estadoBien">
                    <option value="NUEVO" {{#if (eq estadoBien "NUEVO")}}selected{{/if}}>Nuevo / Sellado</option>
                    <option value="USADO" {{#if (eq estadoBien "USADO")}}selected{{/if}}>Usado en buen estado</option>
                  </select>
                </div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="bien-item" data-indice="1">
            <div class="bien-item__encabezado">
              <span class="bien-item__titulo">Artículo #1</span>
              <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien" style="display: none;">Quitar</button>
            </div>
            <div class="grilla grilla--3">
              <div class="campo{{#if errores.subcategoria}} campo--error{{/if}}">
                <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
                <select name="subcategoria" required data-buscador="Buscá una subcategoría">
                  <option value="">Seleccioná subcategoría...</option>
                  {{#each catalogo}}
                    <optgroup label="{{nombre}}">
                      {{#each subcategorias}}
                        <option value="{{this}}" {{#if (eq ../../form.subcategoria this)}}selected{{/if}}>{{this}}</option>
                      {{/each}}
                    </optgroup>
                  {{/each}}
                </select>
                {{#if errores.subcategoria}}<small class="campo__error">{{errores.subcategoria}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.bienDescripcion}} campo--error{{/if}}">
                <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="text" name="bienDescripcion" value="{{form.bienDescripcion}}" required placeholder="ej: Fideos secos x 500 g">
                {{#if errores.bienDescripcion}}<small class="campo__error">{{errores.bienDescripcion}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.cantidad}} campo--error{{/if}}">
                <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="number" name="cantidad" value="{{form.cantidad}}" required min="1" placeholder="50">
                {{#if errores.cantidad}}<small class="campo__error">{{errores.cantidad}}</small>{{/if}}
              </div>
            </div>

            <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
              <div class="campo">
                <label>Fecha de vencimiento (si aplica)</label>
                <input type="date" name="fechaVencimiento" value="{{form.fechaVencimiento}}">
              </div>
              <div class="campo">
                <label>Peso por unidad (kg)</label>
                <input type="number" name="pesoKg" value="{{#if form.pesoKg}}{{form.pesoKg}}{{else}}1.0{{/if}}" min="0.01" step="any" placeholder="1.0">
              </div>
              <div class="campo">
                <label>Volumen por unidad (m³)</label>
                <input type="number" name="volumenM3" value="{{#if form.volumenM3}}{{form.volumenM3}}{{else}}0.001{{/if}}" min="0.0001" step="any" placeholder="0.001">
              </div>
              <div class="campo">
                <label>Estado de los bienes</label>
                <select name="estadoBien">
                  <option value="NUEVO" {{#if (eq form.estadoBien "NUEVO")}}selected{{/if}}>Nuevo / Sellado</option>
                  <option value="USADO" {{#if (eq form.estadoBien "USADO")}}selected{{/if}}>Usado en buen estado</option>
                </select>
              </div>
            </div>
          </div>
        {{/if}}
      </div>

      <button type="button" class="boton boton--secundario" id="btn-agregar-bien" style="margin-top: var(--espacio-2);">
        + Agregar otro artículo a la donación
      </button>
    </div>

    <div class="acciones" style="margin-top: var(--espacio-5); justify-content: flex-end;">
      {{boton "cancelar" href="/admin"}}
      {{boton "confirmar" texto="Registrar recepción en depósito" type="submit"}}
    </div>
  </form>
</section>

{{!-- Modal de Alta Rápida de Donante Presencial --}}
<dialog class="modal modal--ancho" id="modal-donante" aria-labelledby="titulo-donante" {{#if abrirModalDonante}}open{{/if}}>
  <form method="post" action="/admin/recepcion/donante" accept-charset="UTF-8" novalidate>
    <div class="modal__encabezado">
      <h2 id="titulo-donante">Nuevo donante presencial</h2>
      <a class="modal__cerrar" href="/admin/recepcion" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></a>
    </div>
    <div class="modal__cuerpo">
      {{#if errorDonante}}<div class="alerta alerta--error" role="alert">{{errorDonante}}</div>{{/if}}

      <p class="texto-suave">Registrá a la persona u organización que se presentó en depósito para poder asociarle la entrega.</p>

      <div class="campo" style="margin-bottom: var(--espacio-4);">
        <label id="etiqueta-tipo-donante">Tipo de donante</label>
        <div class="selector-toggle" role="radiogroup" aria-labelledby="etiqueta-tipo-donante">
          <label class="selector-toggle__opcion" id="label-humana">
            <input type="radio" name="tipoPersona" value="HUMANA" checked id="radio-humana" class="sr-only">
            <svg class="icono" aria-hidden="true"><use href="#i-usuario"/></svg>
            <span>Persona Humana</span>
          </label>
          <label class="selector-toggle__opcion" id="label-juridica">
            <input type="radio" name="tipoPersona" value="JURIDICA" id="radio-juridica" class="sr-only">
            <svg class="icono" aria-hidden="true"><use href="#i-edificio"/></svg>
            <span>Persona Jurídica / Org.</span>
          </label>
        </div>
      </div>

      <div id="campos-humana">
        <h3 style="font-size: var(--tamano-base); margin-top: var(--espacio-2); margin-bottom: var(--espacio-2); color: var(--color-primario);">Datos de la persona</h3>
        <div class="grilla grilla--2">
          <div class="campo{{#if erroresDonante.nombre}} campo--error{{/if}}">
            <label for="nombre">Nombre <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="nombre" name="nombre" value="{{formDonante.nombre}}" required autofocus placeholder="Mariano">
            {{#if erroresDonante.nombre}}<small class="campo__error">{{erroresDonante.nombre}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.apellido}} campo--error{{/if}}">
            <label for="apellido">Apellido <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="apellido" name="apellido" value="{{formDonante.apellido}}" required placeholder="López">
            {{#if erroresDonante.apellido}}<small class="campo__error">{{erroresDonante.apellido}}</small>{{/if}}
          </div>
        </div>

        <div class="grilla grilla--3">
          <div class="campo{{#if erroresDonante.dni}} campo--error{{/if}}">
            <label for="dni">DNI <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="dni" name="dni" value="{{formDonante.dni}}" required placeholder="34567890">
            {{#if erroresDonante.dni}}<small class="campo__error">{{erroresDonante.dni}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.fechaNacimiento}} campo--error{{/if}}">
            <label for="fechaNacimiento">Fecha de nacimiento</label>
            <input type="date" id="fechaNacimiento" name="fechaNacimiento" value="{{formDonante.fechaNacimiento}}">
            {{#if erroresDonante.fechaNacimiento}}<small class="campo__error">{{erroresDonante.fechaNacimiento}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.genero}} campo--error{{/if}}">
            <label for="genero">Género</label>
            <select id="genero" name="genero">
              <option value="">Elegí una opción</option>
              <option value="Femenino" {{#if (eq formDonante.genero "Femenino")}}selected{{/if}}>Femenino</option>
              <option value="Masculino" {{#if (eq formDonante.genero "Masculino")}}selected{{/if}}>Masculino</option>
              <option value="No binario" {{#if (eq formDonante.genero "No binario")}}selected{{/if}}>No binario</option>
              <option value="Otro" {{#if (eq formDonante.genero "Otro")}}selected{{/if}}>Otro</option>
              <option value="Prefiero no decirlo" {{#if (eq formDonante.genero "Prefiero no decirlo")}}selected{{/if}}>Prefiero no decirlo</option>
            </select>
            {{#if erroresDonante.genero}}<small class="campo__error">{{erroresDonante.genero}}</small>{{/if}}
          </div>
        </div>

        <div class="campo{{#if erroresDonante.direccion}} campo--error{{/if}}">
          <label for="direccion">Dirección</label>
          <input type="text" id="direccion" name="direccion" value="{{formDonante.direccion}}" placeholder="Calle y número, localidad">
          {{#if erroresDonante.direccion}}<small class="campo__error">{{erroresDonante.direccion}}</small>{{/if}}
        </div>
      </div>

      <div id="campos-juridica" style="display:none;">
        <h3 style="font-size: var(--tamano-base); margin-top: var(--espacio-2); margin-bottom: var(--espacio-2); color: var(--color-primario);">Datos de la organización</h3>
        <div class="campo{{#if erroresDonante.razonSocial}} campo--error{{/if}}">
          <label for="razonSocial">Razón social <span class="campo__requerido" aria-hidden="true">*</span></label>
          <input type="text" id="razonSocial" name="razonSocial" value="{{formDonante.razonSocial}}" placeholder="Molinos Río de la Plata">
          {{#if erroresDonante.razonSocial}}<small class="campo__error">{{erroresDonante.razonSocial}}</small>{{/if}}
        </div>

        <div class="grilla grilla--3">
          <div class="campo{{#if erroresDonante.cuit}} campo--error{{/if}}">
            <label for="cuit">CUIT <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="cuit" name="cuit" value="{{formDonante.cuit}}" placeholder="30500012349">
            {{#if erroresDonante.cuit}}<small class="campo__error">{{erroresDonante.cuit}}</small>{{/if}}
            <small class="texto-suave">Sin guiones, 11 dígitos.</small>
          </div>
          <div class="campo{{#if erroresDonante.rubro}} campo--error{{/if}}">
            <label for="rubro">Rubro <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="rubro" name="rubro" value="{{formDonante.rubro}}" placeholder="Alimenticio">
            {{#if erroresDonante.rubro}}<small class="campo__error">{{erroresDonante.rubro}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.tipo}} campo--error{{/if}}">
            <label for="tipo">Tipo <span class="campo__requerido" aria-hidden="true">*</span></label>
            <select id="tipo" name="tipo">
              <option value="">Elegí una opción</option>
              <option value="EMPRESA" {{#if (eq formDonante.tipo "EMPRESA")}}selected{{/if}}>Empresa</option>
              <option value="ONG" {{#if (eq formDonante.tipo "ONG")}}selected{{/if}}>ONG</option>
              <option value="INSTITUCION" {{#if (eq formDonante.tipo "INSTITUCION")}}selected{{/if}}>Institución</option>
              <option value="GUBERNAMENTAL" {{#if (eq formDonante.tipo "GUBERNAMENTAL")}}selected{{/if}}>Gubernamental</option>
            </select>
            {{#if erroresDonante.tipo}}<small class="campo__error">{{erroresDonante.tipo}}</small>{{/if}}
          </div>
        </div>

        <h3 style="font-size: var(--tamano-base); margin-top: var(--espacio-4); margin-bottom: var(--espacio-2); color: var(--color-primario);">Representante</h3>
        <div class="grilla grilla--3">
          <div class="campo{{#if erroresDonante.representanteNombre}} campo--error{{/if}}">
            <label for="representanteNombre">Nombre <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="representanteNombre" name="representanteNombre" value="{{formDonante.representanteNombre}}" placeholder="Juan">
            {{#if erroresDonante.representanteNombre}}<small class="campo__error">{{erroresDonante.representanteNombre}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.representanteApellido}} campo--error{{/if}}">
            <label for="representanteApellido">Apellido <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="text" id="representanteApellido" name="representanteApellido" value="{{formDonante.representanteApellido}}" placeholder="Pérez">
            {{#if erroresDonante.representanteApellido}}<small class="campo__error">{{erroresDonante.representanteApellido}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.representanteCorreo}} campo--error{{/if}}">
            <label for="representanteCorreo">Email <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="email" id="representanteCorreo" name="representanteCorreo" value="{{formDonante.representanteCorreo}}" placeholder="representante@empresa.com">
            {{#if erroresDonante.representanteCorreo}}<small class="campo__error">{{erroresDonante.representanteCorreo}}</small>{{/if}}
          </div>
        </div>
      </div>

      <div id="campos-contacto">
        <h3 style="font-size: var(--tamano-base); margin-top: var(--espacio-4); margin-bottom: var(--espacio-2); color: var(--color-primario);">Contacto</h3>
        <p class="texto-suave" style="margin-bottom: var(--espacio-2); font-size: var(--tamano-sm);">Medio de aviso cuando cambie el estado de las donaciones.</p>
        <div class="grilla grilla--2">
          <div class="campo{{#if erroresDonante.email}} campo--error{{/if}}">
            <label for="email">Email <span class="campo__requerido" aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" value="{{formDonante.email}}" required placeholder="contacto@ejemplo.com">
            {{#if erroresDonante.email}}<small class="campo__error">{{erroresDonante.email}}</small>{{/if}}
          </div>
          <div class="campo{{#if erroresDonante.telefono}} campo--error{{/if}}">
            <label for="telefono">Teléfono (opcional)</label>
            <input type="tel" id="telefono" name="telefono" value="{{formDonante.telefono}}" placeholder="11 4433-2211">
            {{#if erroresDonante.telefono}}<small class="campo__error">{{erroresDonante.telefono}}</small>{{/if}}
          </div>
        </div>

        <div class="grilla grilla--2">
          <div class="campo">
            <label for="tipoTelefono">El teléfono es de</label>
            <select id="tipoTelefono" name="tipoTelefono">
              <option value="WHATSAPP" {{#if (eq formDonante.tipoTelefono "WHATSAPP")}}selected{{/if}}>WhatsApp</option>
              <option value="SMS" {{#if (eq formDonante.tipoTelefono "SMS")}}selected{{/if}}>SMS</option>
            </select>
          </div>
          <div class="campo">
            <label for="contactoPredeterminado">Preferimos avisar por</label>
            <select id="contactoPredeterminado" name="contactoPredeterminado">
              <option value="EMAIL" {{#if (eq formDonante.contactoPredeterminado "EMAIL")}}selected{{/if}}>Email</option>
              <option value="TELEFONO" {{#if (eq formDonante.contactoPredeterminado "TELEFONO")}}selected{{/if}}>Teléfono</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="modal__acciones">
      {{boton "cancelar" href="/admin/recepcion" cierra=true}}
      <button type="submit" class="boton">Guardar y seleccionar</button>
    </div>
  </form>
</dialog>

{{!-- Plantilla para clonar dinámicamente nuevos artículos --}}
<template id="template-bien">
  <div class="bien-item" data-indice="__INDICE__">
    <div class="bien-item__encabezado">
      <span class="bien-item__titulo">Artículo #__INDICE__</span>
      <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien">Quitar</button>
    </div>
    <div class="grilla grilla--3">
      <div class="campo">
        <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
        <select name="subcategoria" required data-buscador="Buscá una subcategoría">
          <option value="">Seleccioná subcategoría...</option>
          {{#each catalogo}}
            <optgroup label="{{nombre}}">
              {{#each subcategorias}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </optgroup>
          {{/each}}
        </select>
      </div>
      <div class="campo">
        <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="text" name="bienDescripcion" required placeholder="ej: Fideos secos x 500 g">
      </div>
      <div class="campo">
        <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="number" name="cantidad" required min="1" placeholder="50">
      </div>
    </div>

    <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
      <div class="campo">
        <label>Fecha de vencimiento (si aplica)</label>
        <input type="date" name="fechaVencimiento">
      </div>
      <div class="campo">
        <label>Peso por unidad (kg)</label>
        <input type="number" name="pesoKg" value="1.0" min="0.01" step="any" placeholder="1.0">
      </div>
      <div class="campo">
        <label>Volumen por unidad (m³)</label>
        <input type="number" name="volumenM3" value="0.001" min="0.0001" step="any" placeholder="0.001">
      </div>
      <div class="campo">
        <label>Estado de los bienes</label>
        <select name="estadoBien">
          <option value="NUEVO">Nuevo / Sellado</option>
          <option value="USADO">Usado en buen estado</option>
        </select>
      </div>
    </div>
  </div>
</template>

<script>
(function () {
  var contenedor = document.getElementById('contenedor-bienes');
  var btnAgregar = document.getElementById('btn-agregar-bien');
  var template = document.getElementById('template-bien');

  function actualizarNumeracion() {
    if (!contenedor) return;
    var items = contenedor.querySelectorAll('.bien-item');
    items.forEach(function (item, idx) {
      var nro = idx + 1;
      item.dataset.indice = nro;
      var tit = item.querySelector('.bien-item__titulo');
      if (tit) tit.textContent = 'Artículo #' + nro;
      var btn = item.querySelector('.btn-quitar-bien');
      if (btn) btn.style.display = items.length > 1 ? 'inline-flex' : 'none';
    });
  }

  if (btnAgregar && template && contenedor) {
    btnAgregar.addEventListener('click', function () {
      var nuevoIndice = contenedor.querySelectorAll('.bien-item').length + 1;
      var clon = template.content.cloneNode(true);
      var item = clon.querySelector('.bien-item');
      item.dataset.indice = nuevoIndice;
      var tit = item.querySelector('.bien-item__titulo');
      if (tit) tit.textContent = 'Artículo #' + nuevoIndice;

      contenedor.appendChild(clon);
      var agregado = contenedor.lastElementChild;
      if (window.inicializarBuscadores) {
        window.inicializarBuscadores(agregado);
      }
      actualizarNumeracion();
      var primerCampo = agregado.querySelector('input[name="bienDescripcion"]');
      if (primerCampo) primerCampo.focus();
    });

    contenedor.addEventListener('click', function (e) {
      var btnQuitar = e.target.closest('.btn-quitar-bien');
      if (btnQuitar) {
        var item = btnQuitar.closest('.bien-item');
        if (item && contenedor.querySelectorAll('.bien-item').length > 1) {
          item.remove();
          actualizarNumeracion();
        }
      }
    });

    actualizarNumeracion();
  }

  // Toggle tipo de donante presencial (Humana / Jurídica)
  var radioHumana = document.getElementById('radio-humana');
  var radioJuridica = document.getElementById('radio-juridica');
  var labelHumana = document.getElementById('label-humana');
  var labelJuridica = document.getElementById('label-juridica');
  var camposHumana = document.getElementById('campos-humana');
  var camposJuridica = document.getElementById('campos-juridica');

  function toggleTipoPersona() {
    if (!radioHumana || !radioJuridica) return;
    var esJuridica = radioJuridica.checked;

    if (labelHumana && labelJuridica) {
      labelHumana.classList.toggle('selector-toggle__opcion--activa', !esJuridica);
      labelJuridica.classList.toggle('selector-toggle__opcion--activa', esJuridica);
      labelHumana.setAttribute('aria-checked', !esJuridica ? 'true' : 'false');
      labelJuridica.setAttribute('aria-checked', esJuridica ? 'true' : 'false');
    }

    if (camposHumana) {
      camposHumana.style.display = esJuridica ? 'none' : '';
      camposHumana.querySelectorAll('input, select').forEach(function (el) {
        el.disabled = esJuridica;
      });
    }

    if (camposJuridica) {
      camposJuridica.style.display = esJuridica ? '' : 'none';
      camposJuridica.querySelectorAll('input, select').forEach(function (el) {
        el.disabled = !esJuridica;
      });
    }
  }

  if (radioHumana && radioJuridica) {
    radioHumana.addEventListener('change', toggleTipoPersona);
    radioJuridica.addEventListener('change', toggleTipoPersona);
    if ("{{formDonante.tipoPersona}}" === "JURIDICA") {
      radioJuridica.checked = true;
    }
    toggleTipoPersona();
  }
})();
</script>

