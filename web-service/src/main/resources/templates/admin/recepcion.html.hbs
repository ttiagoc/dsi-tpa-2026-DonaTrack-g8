{{#partial "titulo"}}Recepción en Depósito · DonaTrack{{/partial}}
{{#partial "contenido"}}
{{> partials/encabezado
    titulo="Recepción de Donaciones en Depósito"
    bajada="Registrá el ingreso físico de donaciones y asociá donantes presenciales en el centro de acopio."
    accionHref="/admin/recepcion?nuevoDonante=true"
    accionTexto="Nuevo donante"
    accionModal="modal-donante"}}

<div class="resumen">
  <div class="resumen__item"><strong>{{totalDonantes}}</strong>Donantes registrados</div>
  <div class="resumen__item resumen__item--ok"><strong>{{resumen.ingresosMes}}</strong>Donaciones en depósito</div>
  <div class="resumen__item resumen__item--info"><strong>Depósito Central</strong>Ubicación operativa</div>
</div>

<section class="tarjeta">
  <form method="post" action="/admin/recepcion" novalidate>
    {{#if errorGeneral}}<div class="alerta alerta--error" role="alert">{{errorGeneral}}</div>{{/if}}

    <div class="seccion-form">
      <h2 class="seccion-form__titulo">1. Donante</h2>
      <div class="campo{{#if errores.donanteId}} campo--error{{/if}}">
        <label for="donanteId">Donante que entrega los bienes <span class="campo__requerido" aria-hidden="true">*</span></label>
        <select id="donanteId" name="donanteId" required data-buscador="Buscá por DNI, CUIT o nombre">
          <option value="">Seleccioná un donante...</option>
          {{#each donantes}}
            <option value="{{id}}" {{#if (eq ../form.donanteId idStr)}}selected{{/if}}>{{etiquetaBuscador}}</option>
          {{/each}}
        </select>
        {{#if errores.donanteId}}<small class="campo__error">{{errores.donanteId}}</small>{{/if}}
      </div>
    </div>

    <div class="seccion-form">
      <h2 class="seccion-form__titulo">2. Datos de la Entrega</h2>
      <div class="campo{{#if errores.descripcion}} campo--error{{/if}}">
        <label for="descripcion">Descripción general de la donación</label>
        <input type="text" id="descripcion" name="descripcion" value="{{form.descripcion}}">
        {{#if errores.descripcion}}<small class="campo__error">{{errores.descripcion}}</small>{{/if}}
      </div>
    </div>

    <div class="seccion-form">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--espacio-2);">
        <div>
          <h2 class="seccion-form__titulo" style="margin-bottom: var(--espacio-1);">3. Artículos / Bienes a Recibir</h2>
          <p class="texto-suave" style="margin: 0;">
            Podés cargar todos los artículos que entregue la persona. El sistema realizará la <strong>segmentación automática</strong> en donaciones independientes agrupadas por subcategoría, vencimiento y estado.
          </p>
        </div>
      </div>

      <div id="contenedor-bienes" style="margin-top: var(--espacio-3);">
        {{#if bienes}}
          {{#each bienes}}
            <div class="bien-item" data-indice="{{indice}}">
              <div class="bien-item__encabezado">
                <span class="bien-item__titulo">Artículo #{{indice}}</span>
                <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien">Quitar</button>
              </div>
              <div class="grilla grilla--3">
                <div class="campo{{#if ../errores.subcategoria}} campo--error{{/if}}">
                  <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <select name="subcategoria" required data-buscador="Buscá una subcategoría">
                    <option value="">Seleccioná subcategoría...</option>
                    {{#each ../catalogo}}
                      <optgroup label="{{categoria}}" data-pide-estado="{{#if pideEstado}}si{{else}}no{{/if}}" data-perecedero="{{#if esPerecedero}}si{{else}}no{{/if}}">
                        {{#each subcategorias}}
                          <option value="{{this}}" {{#if (eq ../../subcategoria this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                      </optgroup>
                    {{/each}}
                  </select>
                  {{#if ../errores.subcategoria}}<small class="campo__error">{{../errores.subcategoria}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.bienDescripcion}} campo--error{{/if}}">
                  <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="text" name="bienDescripcion" value="{{bienDescripcion}}" required placeholder="ej: Fideos secos x 500 g">
                  {{#if ../errores.bienDescripcion}}<small class="campo__error">{{../errores.bienDescripcion}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.cantidad}} campo--error{{/if}}">
                  <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="number" name="cantidad" value="{{cantidad}}" required min="1" placeholder="50">
                  {{#if ../errores.cantidad}}<small class="campo__error">{{../errores.cantidad}}</small>{{/if}}
                </div>
              </div>

              <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
                <div class="campo{{#if ../errores.fechaVencimiento}} campo--error{{/if}}" data-campo-vencimiento>
                  <label>Fecha de vencimiento</label>
                  <input type="date" name="fechaVencimiento" value="{{fechaVencimiento}}">
                  <input type="hidden" name="fechaVencimiento" value="" disabled data-no-aplica>
                  <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no vence</small>
                  {{#if ../errores.fechaVencimiento}}<small class="campo__error">{{../errores.fechaVencimiento}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.pesoKg}} campo--error{{/if}}">
                  <label>Peso por unidad (kg) <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="number" name="pesoKg" value="{{pesoKg}}" required min="0.01" step="any" placeholder="0.5">
                  {{#if ../errores.pesoKg}}<small class="campo__error">{{../errores.pesoKg}}</small>{{/if}}
                </div>
                <div class="campo{{#if ../errores.volumenM3}} campo--error{{/if}}">
                  <label>Volumen por unidad (m³) <span class="campo__requerido" aria-hidden="true">*</span></label>
                  <input type="number" name="volumenM3" value="{{volumenM3}}" required min="0.0001" step="any" placeholder="0.001">
                  {{#if ../errores.volumenM3}}<small class="campo__error">{{../errores.volumenM3}}</small>{{/if}}
                </div>
                <div class="campo" data-campo-estado>
                  <label>Estado de los bienes</label>
                  <select name="estadoBien">
                    <option value="NUEVO" {{#if (eq estadoBien "NUEVO")}}selected{{/if}}>Nuevo / Sellado</option>
                    <option value="USADO" {{#if (eq estadoBien "USADO")}}selected{{/if}}>Usado en buen estado</option>
                  </select>
                  <input type="hidden" name="estadoBien" value="" disabled data-no-aplica>
                  <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no registra estado</small>
                </div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="bien-item" data-indice="1">
            <div class="bien-item__encabezado">
              <span class="bien-item__titulo">Artículo #1</span>
              <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien" style="display: none;">Quitar</button>
            </div>
            <div class="grilla grilla--3">
              <div class="campo{{#if errores.subcategoria}} campo--error{{/if}}">
                <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
                <select name="subcategoria" required data-buscador="Buscá una subcategoría">
                  <option value="">Seleccioná subcategoría...</option>
                  {{#each catalogo}}
                    <optgroup label="{{categoria}}" data-pide-estado="{{#if pideEstado}}si{{else}}no{{/if}}" data-perecedero="{{#if esPerecedero}}si{{else}}no{{/if}}">
                      {{#each subcategorias}}
                        <option value="{{this}}" {{#if (eq ../../form.subcategoria this)}}selected{{/if}}>{{this}}</option>
                      {{/each}}
                    </optgroup>
                  {{/each}}
                </select>
                {{#if errores.subcategoria}}<small class="campo__error">{{errores.subcategoria}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.bienDescripcion}} campo--error{{/if}}">
                <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="text" name="bienDescripcion" value="{{form.bienDescripcion}}" required placeholder="ej: Fideos secos x 500 g">
                {{#if errores.bienDescripcion}}<small class="campo__error">{{errores.bienDescripcion}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.cantidad}} campo--error{{/if}}">
                <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="number" name="cantidad" value="{{form.cantidad}}" required min="1" placeholder="50">
                {{#if errores.cantidad}}<small class="campo__error">{{errores.cantidad}}</small>{{/if}}
              </div>
            </div>

            <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
              <div class="campo{{#if errores.fechaVencimiento}} campo--error{{/if}}" data-campo-vencimiento>
                <label>Fecha de vencimiento</label>
                <input type="date" name="fechaVencimiento" value="{{form.fechaVencimiento}}">
                <input type="hidden" name="fechaVencimiento" value="" disabled data-no-aplica>
                <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no vence</small>
                {{#if errores.fechaVencimiento}}<small class="campo__error">{{errores.fechaVencimiento}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.pesoKg}} campo--error{{/if}}">
                <label>Peso por unidad (kg) <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="number" name="pesoKg" value="{{form.pesoKg}}" required min="0.01" step="any" placeholder="0.5">
                {{#if errores.pesoKg}}<small class="campo__error">{{errores.pesoKg}}</small>{{/if}}
              </div>
              <div class="campo{{#if errores.volumenM3}} campo--error{{/if}}">
                <label>Volumen por unidad (m³) <span class="campo__requerido" aria-hidden="true">*</span></label>
                <input type="number" name="volumenM3" value="{{form.volumenM3}}" required min="0.0001" step="any" placeholder="0.001">
                {{#if errores.volumenM3}}<small class="campo__error">{{errores.volumenM3}}</small>{{/if}}
              </div>
              <div class="campo" data-campo-estado>
                <label>Estado de los bienes</label>
                <select name="estadoBien">
                  <option value="NUEVO" {{#if (eq form.estadoBien "NUEVO")}}selected{{/if}}>Nuevo / Sellado</option>
                  <option value="USADO" {{#if (eq form.estadoBien "USADO")}}selected{{/if}}>Usado en buen estado</option>
                </select>
                <input type="hidden" name="estadoBien" value="" disabled data-no-aplica>
                <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no registra estado</small>
              </div>
            </div>
          </div>
        {{/if}}
      </div>

      <button type="button" class="boton boton--secundario" id="btn-agregar-bien" style="margin-top: var(--espacio-2);">
        + Agregar otro artículo a la donación
      </button>
    </div>

    <div class="acciones" style="margin-top: var(--espacio-5); justify-content: flex-end;">
      {{boton "cancelar" href="/admin"}}
      {{boton "confirmar" texto="Registrar recepción en depósito" type="submit"}}
    </div>
  </form>
</section>

{{!-- Modal de Alta Rápida de Donante Presencial --}}
<dialog class="modal modal--ancho" id="modal-donante" aria-labelledby="titulo-donante" {{#if abrirModalDonante}}open{{/if}}>
  <form method="post" action="/admin/recepcion/donante" accept-charset="UTF-8" novalidate>
    <div class="modal__encabezado">
      <h2 id="titulo-donante">Nuevo donante presencial</h2>
      <a class="modal__cerrar" href="/admin/recepcion" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></a>
    </div>
    <div class="modal__cuerpo">
      {{#if errorDonante}}<div class="alerta alerta--error" role="alert">{{errorDonante}}</div>{{/if}}

      <p class="texto-suave">Registrá a la persona u organización que se presentó en depósito para poder asociarle la entrega.</p>

      {{> partials/form-donante}}
    </div>
    <div class="modal__acciones">
      {{boton "cancelar" href="/admin/recepcion" cierra=true}}
      <button type="submit" class="boton">Guardar y seleccionar</button>
    </div>
  </form>
</dialog>

{{!-- Plantilla para clonar dinámicamente nuevos artículos --}}
<template id="template-bien">
  <div class="bien-item" data-indice="__INDICE__">
    <div class="bien-item__encabezado">
      <span class="bien-item__titulo">Artículo #__INDICE__</span>
      <button type="button" class="boton boton--secundario boton--peligro boton--chico btn-quitar-bien">Quitar</button>
    </div>
    <div class="grilla grilla--3">
      <div class="campo">
        <label>Subcategoría del bien <span class="campo__requerido" aria-hidden="true">*</span></label>
        <select name="subcategoria" required data-buscador="Buscá una subcategoría">
          <option value="">Seleccioná subcategoría...</option>
          {{#each catalogo}}
            <optgroup label="{{categoria}}" data-pide-estado="{{#if pideEstado}}si{{else}}no{{/if}}" data-perecedero="{{#if esPerecedero}}si{{else}}no{{/if}}">
              {{#each subcategorias}}
                <option value="{{this}}">{{this}}</option>
              {{/each}}
            </optgroup>
          {{/each}}
        </select>
      </div>
      <div class="campo">
        <label>Detalle del artículo <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="text" name="bienDescripcion" required placeholder="ej: Fideos secos x 500 g">
      </div>
      <div class="campo">
        <label>Cantidad de unidades <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="number" name="cantidad" required min="1" placeholder="50">
      </div>
    </div>

    <div class="grilla grilla--4" style="margin-top: var(--espacio-3);">
      <div class="campo" data-campo-vencimiento>
        <label>Fecha de vencimiento</label>
        <input type="date" name="fechaVencimiento">
        <input type="hidden" name="fechaVencimiento" value="" disabled data-no-aplica>
        <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no vence</small>
      </div>
      <div class="campo">
        <label>Peso por unidad (kg) <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="number" name="pesoKg" required min="0.01" step="any" placeholder="0.5">
      </div>
      <div class="campo">
        <label>Volumen por unidad (m³) <span class="campo__requerido" aria-hidden="true">*</span></label>
        <input type="number" name="volumenM3" required min="0.0001" step="any" placeholder="0.001">
      </div>
      <div class="campo" data-campo-estado>
        <label>Estado de los bienes</label>
        <select name="estadoBien">
          <option value="NUEVO">Nuevo / Sellado</option>
          <option value="USADO">Usado en buen estado</option>
        </select>
        <input type="hidden" name="estadoBien" value="" disabled data-no-aplica>
        <small class="campo__ayuda" data-aviso-no-aplica hidden>No aplica: la categoría no registra estado</small>
      </div>
    </div>
  </div>
</template>

<script>
(function () {
  var contenedor = document.getElementById('contenedor-bienes');
  var btnAgregar = document.getElementById('btn-agregar-bien');
  var template = document.getElementById('template-bien');

  function actualizarNumeracion() {
    if (!contenedor) return;
    var items = contenedor.querySelectorAll('.bien-item');
    items.forEach(function (item, idx) {
      var nro = idx + 1;
      item.dataset.indice = nro;
      var tit = item.querySelector('.bien-item__titulo');
      if (tit) tit.textContent = 'Artículo #' + nro;
      var btn = item.querySelector('.btn-quitar-bien');
      if (btn) btn.style.display = items.length > 1 ? 'inline-flex' : 'none';
    });
  }

  // Habilita o bloquea un campo del articulo. Bloqueado, manda vacio por el hidden de al lado
  // para que las listas de campos (subcategoria, cantidad, ...) sigan alineadas por articulo.
  function aplicar(caja, aplica, obligatorio) {
    if (!caja) return;
    var campo = caja.querySelector('input:not([type="hidden"]), select');
    var reemplazo = caja.querySelector('[data-no-aplica]');
    var aviso = caja.querySelector('[data-aviso-no-aplica]');
    campo.disabled = !aplica;
    reemplazo.disabled = aplica;
    if (aviso) aviso.hidden = aplica;
    if (!aplica && campo.type === 'date') campo.value = '';
    if (obligatorio !== undefined) campo.required = aplica && obligatorio;
    if (!aplica) {
      caja.classList.remove('campo--error');
      var error = caja.querySelector('.campo__error');
      if (error) error.remove();
    }
  }

  // Segun la categoria de la subcategoria elegida: el estado solo si la categoria lo registra
  // y la fecha de vencimiento solo (y obligatoria) si es perecedera.
  function aplicarCategoria(item) {
    var select = item.querySelector('select[name="subcategoria"]');
    var opcion = select && select.selectedOptions[0];
    var grupo = opcion && opcion.value ? opcion.closest('optgroup') : null;
    var pideEstado = !grupo || grupo.dataset.pideEstado === 'si';
    var perecedero = !grupo || grupo.dataset.perecedero === 'si';
    aplicar(item.querySelector('[data-campo-estado]'), pideEstado);
    aplicar(item.querySelector('[data-campo-vencimiento]'), perecedero, !!grupo);
    var etiqueta = item.querySelector('[data-campo-vencimiento] label');
    if (etiqueta) {
      etiqueta.innerHTML = 'Fecha de vencimiento' + (grupo && perecedero
          ? ' <span class="campo__requerido" aria-hidden="true">*</span>' : '');
    }
  }

  if (contenedor) {
    contenedor.querySelectorAll('.bien-item').forEach(aplicarCategoria);
    contenedor.addEventListener('change', function (e) {
      if (e.target.matches('select[name="subcategoria"]')) {
        aplicarCategoria(e.target.closest('.bien-item'));
      }
    });
  }

  if (btnAgregar && template && contenedor) {
    btnAgregar.addEventListener('click', function () {
      var nuevoIndice = contenedor.querySelectorAll('.bien-item').length + 1;
      var clon = template.content.cloneNode(true);
      var item = clon.querySelector('.bien-item');
      item.dataset.indice = nuevoIndice;
      var tit = item.querySelector('.bien-item__titulo');
      if (tit) tit.textContent = 'Artículo #' + nuevoIndice;

      contenedor.appendChild(clon);
      var agregado = contenedor.lastElementChild;
      if (window.inicializarBuscadores) {
        window.inicializarBuscadores(agregado);
      }
      aplicarCategoria(agregado);
      actualizarNumeracion();
      var primerCampo = agregado.querySelector('input[name="bienDescripcion"]');
      if (primerCampo) primerCampo.focus();
    });

    contenedor.addEventListener('click', function (e) {
      var btnQuitar = e.target.closest('.btn-quitar-bien');
      if (btnQuitar) {
        var item = btnQuitar.closest('.bien-item');
        if (item && contenedor.querySelectorAll('.bien-item').length > 1) {
          item.remove();
          actualizarNumeracion();
        }
      }
    });

    actualizarNumeracion();
  }
})();
</script>
<script src="/js/tipo-donante.js"></script>

{{/partial}}
{{> layouts/base}}
