{{#partial "titulo"}}Matchmaking y Asignaciones · DonaTrack{{/partial}}
{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Matchmaking y Asignaciones</h1>
    <p class="texto-suave">Asignación inteligente de donaciones en depósito a entidades beneficiarias según compatibilidad y necesidad.</p>
  </div>
  <div class="encabezado-pagina__accion">
    <form method="post" action="/admin/matchmaking/ejecutar">
      <button type="submit" class="boton" data-cargando="Ejecutando matchmaking…">
        <svg class="icono" aria-hidden="true"><use href="#i-rayo"/></svg> Ejecutar matchmaking
      </button>
    </form>
  </div>
</header>

<div class="resumen">
  <div class="resumen__item resumen__item--pendiente"><strong>{{resumen.pendientes}}</strong>Propuestas pendientes</div>
  <div class="resumen__item resumen__item--info"><strong>{{resumen.candidatas}}</strong>Entidades candidatas</div>
  <div class="resumen__item resumen__item--ok"><strong>{{resumen.totalSugerencias}}</strong>Recomendaciones generadas</div>
</div>

{{#> partials/listado
    coleccion=propuestas
    vacioTitulo="No hay propuestas de matchmaking pendientes de resolución."
    vacioBajada="Hacé clic en “Ejecutar matchmaking” para procesar las donaciones en depósito y generar nuevas recomendaciones de asignación."}}
  <table class="tabla">
    <caption class="sr-only">Propuestas de asignación generadas por el motor de matchmaking</caption>
    <thead>
      <tr>
        <th scope="col"># ID</th>
        <th scope="col">Donación</th>
        <th scope="col">Bienes y cantidad</th>
        <th scope="col">Fecha de cálculo</th>
        <th scope="col">Sugerencias</th>
        <th scope="col"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      {{#each propuestas}}
        <tr>
          <td class="tabla__corta"><strong>#{{id}}</strong></td>
          <td>
            Donación #{{donacionId}}
            {{#if subcategoria}}<span class="tabla__secundario">{{subcategoria}}{{#if categoria}} · {{categoria}}{{/if}}</span>{{/if}}
          </td>
          <td>{{bienesResumen}}</td>
          <td>{{fechaFormateada}}</td>
          <td><span class="etiqueta etiqueta--info">{{cantidadSugerencias}} {{#if (eq cantidadSugerencias 1)}}entidad sugerida{{else}}entidades sugeridas{{/if}}</span></td>
          {{#> partials/acciones-fila}}
            {{boton "ver" href=(concat "/admin/matchmaking?propuesta=" id) texto="Ver sugerencias" sr=(concat "para donación #" donacionId)}}
          {{/partials/acciones-fila}}
        </tr>
      {{/each}}
    </tbody>
  </table>
  {{> partials/paginacion}}
{{/partials/listado}}

{{#if abrirModalSugerencias}}
<dialog class="modal" id="modal-sugerencias" open aria-labelledby="titulo-sugerencias">
  <form method="post" action="/admin/matchmaking/propuestas/{{propuestaSeleccionada.id}}/aceptar" accept-charset="UTF-8">
    <div class="modal__encabezado">
      <h2 id="titulo-sugerencias">Sugerencias de asignación · Propuesta #{{propuestaSeleccionada.id}}</h2>
      <a class="modal__cerrar" href="/admin/matchmaking" data-cierra aria-label="Cerrar"><svg class="icono"><use href="#i-cerrar"/></svg></a>
    </div>
    <div class="modal__cuerpo">
      <p>Donación <strong>#{{propuestaSeleccionada.donacionId}}: {{propuestaSeleccionada.subcategoria}}</strong> ({{propuestaSeleccionada.bienesResumen}}) actualmente en depósito.</p>
      <p class="texto-suave">El motor evaluó compatibilidad por necesidad declarada y nivel de desatención. Seleccioná a qué entidad querés asignar la entrega:</p>

      {{#if propuestaSeleccionada.entidadesSugeridas}}
        <div class="ranking-lista" role="radiogroup" aria-label="Entidades sugeridas para asignación">
          {{#each propuestaSeleccionada.entidadesSugeridas}}
            <label class="ranking-item {{#if esPrioridadUno}}ranking-item--recomendado ranking-item--seleccionado{{/if}}">
              <input type="radio" name="entidadId" value="{{id}}" {{#if esPrioridadUno}}checked{{/if}} required>
              <div class="ranking-item__info">
                <div class="ranking-item__titulo">
                  <span class="ranking-item__entidad">{{razonSocial}}</span>
                  <div class="ranking-item__badges">
                    {{#if esPrioridadUno}}
                      <span class="etiqueta etiqueta--recomendada" title="Sugerencia con mayor compatibilidad del motor">
                        <svg class="icono" aria-hidden="true"><use href="#i-rayo"/></svg> Recomendada
                      </span>
                    {{else}}
                      <span class="etiqueta etiqueta--neutra">Prioridad #{{orden}}</span>
                    {{/if}}
                    <span class="ranking-item__badge-asignar" aria-hidden="true">
                      <svg class="icono" aria-hidden="true"><use href="#i-tilde"/></svg> Seleccionada para asignar
                    </span>
                  </div>
                </div>
                {{#if direccion}}<span class="texto-suave ranking-item__direccion">{{direccion}}</span>{{/if}}
                {{#if esPrioridadUno}}
                  <span class="ranking-item__nota-recomendada">Prioridad #1 · Mayor nivel de compatibilidad según el motor</span>
                {{/if}}
              </div>
            </label>
          {{/each}}
        </div>

        <div class="ranking-aviso-asignacion">
          <svg class="icono" aria-hidden="true"><use href="#i-conexiones"/></svg>
          <span>La donación se asignará a la entidad marcada como <strong>Seleccionada para asignar</strong>.</span>
        </div>
      {{else}}
        <p class="alerta alerta--info">No se encontraron entidades compatibles en esta propuesta.</p>
      {{/if}}

      <p class="nota">Al asignar la donación, cambiará a estado <strong>Asignación Realizada</strong> y quedará lista para ser planificada en una ruta de transporte.</p>
    </div>
    <div class="modal__acciones" style="justify-content: space-between;">
      {{boton "eliminar" formaction=(concat "/admin/matchmaking/propuestas/" propuestaSeleccionada.id "/rechazar") texto="Descartar propuesta" type="submit"}}
      <div style="display: flex; gap: var(--espacio-2);">
        {{boton "cancelar" href="/admin/matchmaking" cierra=true autofocus=true}}
        {{#if propuestaSeleccionada.entidadesSugeridas}}
          {{boton "confirmar" texto="Confirmar asignación" type="submit"}}
        {{/if}}
      </div>
    </div>
  </form>
</dialog>
{{/if}}

{{/partial}}

{{#partial "scripts"}}
<script>
  (function () {
    var modal = document.getElementById('modal-sugerencias');
    if (!modal) return;
    var radios = modal.querySelectorAll('input[type="radio"][name="entidadId"]');
    function sincronizarSeleccion() {
      radios.forEach(function (radio) {
        var card = radio.closest('.ranking-item');
        if (card) {
          card.classList.toggle('ranking-item--seleccionado', radio.checked);
        }
      });
    }
    radios.forEach(function (radio) {
      radio.addEventListener('change', sincronizarSeleccion);
    });
    sincronizarSeleccion();

    var accionSegura = modal.querySelector('.modal__acciones [autofocus], .modal__acciones [data-cierra]');
    if (accionSegura) {
      try { accionSegura.focus(); } catch (e) {}
    }
  })();
</script>
{{/partial}}
{{> layouts/base}}
