{{#partial "titulo"}}Hoja de ruta · DonaTrack{{/partial}}

{{#partial "head"}}
  {{#if ruta}}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  {{/if}}
{{/partial}}

{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Hoja de ruta</h1>
    <p class="texto-suave">Recorridos asignados a tu camión. Elegí uno para ver el mapa y confirmar cada entrega en destino.</p>
  </div>
  {{#if ruta}}
    <div class="encabezado-pagina__accion">
      {{#if esPlanificada}}
        {{#if otraEnTraslado}}
          <button type="button" class="boton" disabled aria-describedby="aviso-otra-en-traslado">
            <svg class="icono" aria-hidden="true"><use href="#i-camion"/></svg> Comenzar recorrido
          </button>
        {{else}}
          <form method="post" action="/chofer/rutas/{{ruta.id}}/iniciar">
            <button type="submit" class="boton" data-cargando="Iniciando recorrido…">
              <svg class="icono" aria-hidden="true"><use href="#i-camion"/></svg> Comenzar recorrido
            </button>
          </form>
        {{/if}}
      {{else}}
        {{estado ruta.estado}}
      {{/if}}
    </div>
  {{/if}}
</header>

{{#if camion}}
  <section class="tarjeta camion-banner" aria-label="Camión asignado">
    <div class="camion-banner__datos">
      <span class="camion-banner__icono" aria-hidden="true">
        <svg class="icono" aria-hidden="true"><use href="#i-camion"/></svg>
      </span>
      <div>
        <h2 class="camion-banner__titulo">Camión {{camion.patente}} · {{camion.choferNombreCompleto}}</h2>
        <p class="texto-suave camion-banner__detalle">Capacidad: {{cargaCamionFormateada}} kg · {{volumenCamionFormateado}} m³</p>
      </div>
    </div>
    {{#if rutasActivas}}<span class="etiqueta etiqueta--pendiente">{{rutasActivasTexto}}</span>{{/if}}
  </section>
{{/if}}

{{!-- Selector: todas las rutas del camión. Se muestra cuando hay más de una para elegir. --}}
{{#if hayVariasRutas}}
  <nav class="rutas-chofer" aria-label="Tus rutas">
    {{#each rutasActivas}}
      <a class="rutas-chofer__opcion" href="/chofer?ruta={{id}}" {{#if elegida}}aria-current="page"{{/if}}>
        <span class="rutas-chofer__titulo">Ruta #{{id}} {{estado estado}}</span>
        <span class="texto-suave">{{fecha}} · {{paradasTexto}} · {{pendientesTexto}}</span>
      </a>
    {{/each}}
    {{#if rutasFinalizadas}}
      <details class="rutas-chofer__historial" {{#each rutasFinalizadas}}{{#if elegida}}open{{/if}}{{/each}}>
        <summary>Recorridos terminados ({{rutasFinalizadasCount}})</summary>
        <div class="rutas-chofer__lista">
          {{#each rutasFinalizadas}}
            <a class="rutas-chofer__opcion" href="/chofer?ruta={{id}}" {{#if elegida}}aria-current="page"{{/if}}>
              <span class="rutas-chofer__titulo">Ruta #{{id}} {{estado estado}}</span>
              <span class="texto-suave">{{fecha}} · {{paradasTexto}}</span>
            </a>
          {{/each}}
        </div>
      </details>
    {{/if}}
  </nav>
{{/if}}

{{#if ruta}}
  <h2 class="hoja-ruta__titulo">Ruta #{{ruta.id}} · {{ruta.fechaFormateada}} · {{ruta.paradasTexto}}{{#unless esFinalizada}} · {{pendientesTexto}}{{/unless}}</h2>

  {{#if esPlanificada}}
    {{#if otraEnTraslado}}
      <div class="alerta alerta--info" role="status" id="aviso-otra-en-traslado">
        <span>Estás haciendo la <a href="/chofer?ruta={{otraEnTraslado.id}}">Ruta #{{otraEnTraslado.id}}</a>. Cuando la termines vas a poder comenzar esta.</span>
      </div>
    {{else}}
      <div class="alerta alerta--info" role="status">
        <span>Esta hoja de ruta está <strong>Planificada</strong>. Pulsá <strong>Comenzar recorrido</strong> al salir del depósito para activar tu GPS y habilitar la confirmación en cada parada.</span>
      </div>
    {{/if}}
  {{/if}}

  <div class="tarjeta hoja-ruta-mapa__tarjeta">
    <div id="mapa-hoja-ruta" class="hoja-ruta-mapa" role="region" aria-label="Mapa del recorrido de la Ruta #{{ruta.id}}"
         data-deposito-lat="{{depositoLat}}" data-deposito-lng="{{depositoLng}}"
         data-camion-lat="{{camionLat}}" data-camion-lng="{{camionLng}}"
         data-camion-patente="{{#if camion}}{{camion.patente}}{{/if}}"
         {{#if esEnTraslado}}data-mostrar-camion{{/if}}></div>
    <div class="hoja-ruta-mapa__leyenda">
      <strong>D</strong> Depósito central (Av. Medrano 951, CABA)
      {{#if ordenResumen}} · <strong>{{ordenResumen}}</strong> Orden de entrega{{/if}}
      {{#if esEnTraslado}} · <span aria-hidden="true">🚚</span> Posición actual del camión{{/if}}
    </div>
  </div>

  <h2 class="hoja-ruta__titulo">Paradas del recorrido</h2>
  <ol class="paradas-lista">
    {{#each paradas}}
      <li class="parada-item {{#if esProxima}}parada-item--activa{{/if}}{{#if esEntregada}}parada-item--entregada{{/if}}{{#if esFallida}}parada-item--fallida{{/if}}"
          data-parada data-orden="{{orden}}" data-nombre="{{entidadNombre}}" data-direccion="{{destino}}"
          {{#if latitud}}data-lat="{{latitud}}" data-lng="{{longitud}}"{{/if}}
          data-resultado="{{#if esEntregada}}entregada{{else}}{{#if esFallida}}fallida{{/if}}{{/if}}">
        <div class="parada-item__izquierda">
          <span class="parada-item__numero">{{orden}}</span>
          <div class="parada-item__cuerpo">
            <p class="parada-item__titulo">
              {{entidadNombre}}
              {{#if esProxima}}
                <span class="etiqueta etiqueta--pendiente">Próxima parada</span>
              {{else}}
                {{estado estado}}
              {{/if}}
            </p>
            <p class="parada-item__direccion">{{destino}}</p>
            {{#if bultos}}
              <ul class="parada-item__bultos">
                {{#each bultos}}
                  <li><span class="etiqueta etiqueta--neutra">{{this}}</span></li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
        </div>
        {{#if ../esEnTraslado}}
          {{#if esPendiente}}
            <div class="parada-item__acciones">
              <a class="boton boton--chico" href="/chofer?ruta={{../ruta.id}}&confirmarParada={{id}}">Confirmar entrega</a>
              <a class="boton boton--secundario boton--peligro boton--chico" href="/chofer?ruta={{../ruta.id}}&fallarParada={{id}}">No recibida</a>
            </div>
          {{/if}}
        {{/if}}
      </li>
    {{/each}}
  </ol>

  {{#if abrirModalConfirmar}}
  <dialog class="modal" id="modal-confirmar-entrega" open aria-labelledby="modal-entrega-titulo">
    <form method="post" action="/chofer/rutas/{{ruta.id}}/paradas/{{paradaSeleccionada.id}}/confirmar" accept-charset="UTF-8">
      <div class="modal__encabezado">
        <h2 id="modal-entrega-titulo">Confirmar entrega en Parada #{{paradaSeleccionada.orden}}</h2>
        <a class="modal__cerrar" href="/chofer?ruta={{ruta.id}}" data-cierra aria-label="Cerrar">
          <svg class="icono" aria-hidden="true"><use href="#i-cerrar"/></svg>
        </a>
      </div>
      <div class="modal__cuerpo">
        <p>Vas a registrar la entrega en <strong>{{paradaSeleccionada.entidadNombre}}</strong> (<span class="texto-suave">{{paradaSeleccionada.destino}}</span>).</p>
        <dl class="detalle">
          <dt>Ruta</dt>
          <dd>#{{ruta.id}} · {{ruta.fechaFormateada}}</dd>
          <dt>Bultos a descargar</dt>
          <dd><strong>{{paradaSeleccionada.bultosResumen}}</strong></dd>
          {{#if camion}}
            <dt>Camión</dt>
            <dd>{{camion.patente}} ({{camion.choferNombreCompleto}})</dd>
          {{/if}}
        </dl>
        <p class="texto-suave">Al confirmar, se actualizará tu posición GPS en esta sede, las donaciones pasarán a <strong>Entregada</strong> y la entidad recibirá el aviso para subir las fotos de recepción.</p>
      </div>
      <div class="modal__acciones">
        {{boton "cancelar" href=(concat "/chofer?ruta=" ruta.id) cierra=true autofocus=true}}
        <button type="submit" class="boton" data-cargando="Confirmando entrega…">Confirmar entrega</button>
      </div>
    </form>
  </dialog>
  {{/if}}

  {{#if abrirModalFallo}}
  <dialog class="modal" id="modal-fallar-entrega" open aria-labelledby="modal-fallo-titulo">
    <form method="post" action="/chofer/rutas/{{ruta.id}}/paradas/{{paradaSeleccionada.id}}/fallar" accept-charset="UTF-8" novalidate>
      <div class="modal__encabezado">
        <h2 id="modal-fallo-titulo">Reportar entrega no recibida · Parada #{{paradaSeleccionada.orden}}</h2>
        <a class="modal__cerrar" href="/chofer?ruta={{ruta.id}}" data-cierra aria-label="Cerrar">
          <svg class="icono" aria-hidden="true"><use href="#i-cerrar"/></svg>
        </a>
      </div>
      <div class="modal__cuerpo">
        {{#if errorGeneral}}<div class="alerta alerta--error" role="alert">{{errorGeneral}}</div>{{/if}}
        <p>Indicá por qué no se pudo entregar en <strong>{{paradaSeleccionada.entidadNombre}}</strong> (<span class="texto-suave">{{paradaSeleccionada.destino}}</span>).</p>
        <p class="texto-suave">Las donaciones quedarán marcadas como <strong>Entrega fallida</strong> para que administración reprograme el envío o las devuelva al stock del depósito.</p>

        <div class="campo{{#if errores.motivo}} campo--error{{/if}}">
          <label for="motivo">Motivo de no recepción <span class="campo__requerido" aria-hidden="true">*</span></label>
          <textarea id="motivo" name="motivo" rows="3" required autofocus placeholder="Ej: La sede estaba cerrada al llegar el camión y nadie respondió en puerta.">{{form.motivo}}</textarea>
          {{#if errores.motivo}}<small class="campo__error">{{errores.motivo}}</small>{{/if}}
        </div>
      </div>
      <div class="modal__acciones">
        {{boton "cancelar" href=(concat "/chofer?ruta=" ruta.id) cierra=true}}
        {{boton "confirmar_peligro" texto="Registrar no recibida" type="submit" cargando="Registrando…"}}
      </div>
    </form>
  </dialog>
  {{/if}}
{{else}}
  <section class="tarjeta vacio">
    <strong>No tenés una hoja de ruta activa en este momento.</strong>
    Cuando administración planifique un nuevo recorrido para tu camión, vas a ver acá el mapa y las paradas ordenadas para salir a repartir.
    {{#if rutasFinalizadasCount}}
      <span class="vacio__extra">Recorridos completados anteriormente con esta unidad: <b>{{rutasFinalizadasCount}}</b>.</span>
    {{/if}}
  </section>
{{/if}}

{{#if abrirModalCompletada}}
<dialog class="modal" id="modal-ruta-completada" open aria-labelledby="modal-completada-titulo">
  <div class="modal__encabezado">
    <h2 id="modal-completada-titulo">¡Ruta #{{rutaCompletada.id}} completada!</h2>
    <a class="modal__cerrar" href="/chofer" data-cierra aria-label="Cerrar">
      <svg class="icono" aria-hidden="true"><use href="#i-cerrar"/></svg>
    </a>
  </div>
  <div class="modal__cuerpo">
    <div class="alerta alerta--exito" role="status">
      <span>{{#if rutaCompletada.todasEntregadas}}Completaste todas las paradas del recorrido asignado a tu camión.{{else}}Completaste el recorrido de la hoja de ruta asignada a tu camión.{{/if}}</span>
    </div>
    <dl class="detalle">
      <dt>Hoja de ruta</dt>
      <dd><strong>Ruta #{{rutaCompletada.id}}</strong> · Finalizada</dd>
      {{#if rutaCompletada.camionDetalle}}
        <dt>Camión</dt>
        <dd>{{rutaCompletada.camionDetalle}}</dd>
      {{/if}}
      <dt>Resultado de paradas</dt>
      <dd>{{rutaCompletada.resumenParadas}}</dd>
    </dl>
    <p class="texto-suave">{{#if rutaCompletada.todasEntregadas}}Las entidades beneficiarias ya fueron notificadas para confirmar la recepción con fotos.{{else}}Se notificó el estado de cada entrega.{{/if}} {{#if rutasActivas}}Te queda{{#if (eq rutasActivasCount 1)}} 1 ruta{{else}}n {{rutasActivasCount}} rutas{{/if}} por hacer.{{else}}Ya podés regresar al depósito central.{{/if}}</p>
  </div>
  <div class="modal__acciones">
    <a class="boton" href="/chofer" data-cierra autofocus>{{#if rutasActivas}}Ir a la próxima ruta{{else}}Entendido{{/if}}</a>
  </div>
</dialog>
{{/if}}
{{/partial}}

{{#partial "scripts"}}
{{#if ruta}}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="/js/hoja-de-ruta.js"></script>
{{/if}}
{{/partial}}

{{> layouts/base}}
