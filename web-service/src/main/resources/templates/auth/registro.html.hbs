{{#partial "titulo"}}Registrarme · DonaTrack{{/partial}}
{{#partial "contenido"}}
<section class="seccion">
  <h1>Crear una cuenta</h1>
  <p class="texto-suave">Elegí cómo vas a usar DonaTrack.</p>
  <div class="grilla grilla--3">
    <a class="tarjeta tarjeta--opcion" href="/registro/persona-humana">
      <h2>Persona</h2>
      <p>Quiero donar a título personal.</p>
      <span class="tarjeta__accion">Continuar →</span>
    </a>
    <a class="tarjeta tarjeta--opcion" href="/registro/persona-juridica">
      <h2>Empresa u organización</h2>
      <p>Dono en nombre de una empresa, ONG, institución u organismo.</p>
      <span class="tarjeta__accion">Continuar →</span>
    </a>
    <a class="tarjeta tarjeta--opcion" href="/registro/entidad">
      <h2>Entidad beneficiaria</h2>
      <p>Represento a un comedor, escuela u organización que recibe donaciones.</p>
      <span class="tarjeta__accion">Continuar →</span>
    </a>
  </div>
  <p class="formulario__pie">¿Ya tenés cuenta? <a href="/login">Ingresá</a></p>
</section>
{{/partial}}
{{> layouts/base}}
