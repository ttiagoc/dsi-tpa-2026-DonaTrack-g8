{{#partial "titulo"}}Incentivos y Logros · DonaTrack{{/partial}}

{{#partial "contenido"}}
<header class="encabezado-pagina">
  <div>
    <h1>Mis incentivos</h1>
    <p class="texto-suave">Tu impacto solidario. Completá misiones para subir de nivel y desbloquear insignias.</p>
  </div>
</header>

{{#if incentivos}}
  {{!-- Resumen de Nivel --}}
  <div class="resumen" style="margin-bottom: var(--espacio-5);">
    <div class="resumen__item resumen__item--ok">
      <strong>{{incentivos.tituloCategoria}}</strong>
      Nivel actual
    </div>
    <div class="resumen__item">
      <strong>{{incentivos.totalDonaciones}}</strong>
      Donaciones realizadas
    </div>
  </div>

  {{!-- Misiones --}}
  <h2 style="font-size: 1.25rem; margin-bottom: var(--espacio-3);">Misiones</h2>
  <div class="grilla grilla--2" style="margin-bottom: var(--espacio-6);">
    {{#each incentivos.misiones}}
      <article class="tarjeta">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--espacio-3);">
          <div>
            <h3 style="font-size: 1.1rem; margin: 0 0 var(--espacio-1);">{{this.nombre}}</h3>
            <p class="texto-suave" style="font-size: var(--texto-chico); margin: 0;">{{this.descripcion}}</p>
          </div>
          {{#if this.cumplida}}
            <span class="etiqueta">¡Cumplida!</span>
          {{else}}
            <span class="etiqueta etiqueta--pendiente">{{this.progresoActual}} / {{this.meta}}</span>
          {{/if}}
        </div>

        <div class="progreso">
          <div class="progreso__barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{this.porcentaje}}">
            <span style="width: {{this.porcentaje}}%;"></span>
          </div>
          <span class="texto-suave" style="font-size: var(--texto-chico);">Progreso: {{this.porcentaje}}%</span>
        </div>
      </article>
    {{/each}}
  </div>

  {{!-- Insignias Desbloqueadas --}}
  <h2 style="font-size: 1.25rem; margin-bottom: var(--espacio-3);">Insignias desbloqueadas</h2>
  {{#if incentivos.insigniasObtenidas}}
    <div class="grilla grilla--3">
      {{#each incentivos.insigniasObtenidas}}
        <article class="tarjeta" style="text-align: center; padding: var(--espacio-5);">
          <div style="font-size: 2.5rem; margin-bottom: var(--espacio-2);">🎖️</div>
          <h3 style="font-size: 1.05rem; margin: 0 0 var(--espacio-1);">{{this.nombre}}</h3>
          <p class="texto-suave" style="font-size: var(--texto-chico); margin: 0;">{{this.descripcion}}</p>
        </article>
      {{/each}}
    </div>
  {{else}}
    <section class="tarjeta vacio">
      <strong>Aún no desbloqueaste insignias.</strong>
      Completá tus misiones realizando donaciones para conseguir tu primera medalla.
    </section>
  {{/if}}
{{/if}}
{{/partial}}

{{> layouts/base}}