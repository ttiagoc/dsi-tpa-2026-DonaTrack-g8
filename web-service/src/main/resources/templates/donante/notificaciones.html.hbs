{{#partial "titulo"}}Bandeja de Notificaciones — DonaTrack{{/partial}}

{{#partial "contenido"}}
<section class="panel">
  <div class="panel__encabezado">
    <h1>Notificaciones</h1>
    <p>Avisos sobre el estado de tus donaciones, misiones y entregas.</p>
  </div>

  <div class="card">
    {{#if notificaciones}}
      <ul class="lista-notificaciones" style="list-style: none; padding: 0; margin: 0;">
        {{#each notificaciones}}
          <li style="padding: 1rem; border-bottom: 1px solid #e2e8f0; display: flex; gap: 1rem; align-items: center;">
            <span style="font-size: 1.5rem;">🔔</span>
            <div style="flex: 1;">
              <p style="margin: 0; font-weight: 500;">{{this.mensaje}}</p>
              <small style="color: #64748b;">{{this.fechaDeEnvio}}</small>
            </div>
            <span class="badge badge--secundario">{{this.tipoEvento}}</span>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="alerta alerta--info" style="margin: 1.5rem;">
        No tenés notificaciones pendientes en este momento.
      </div>
    {{/if}}
  </div>
</section>
{{/partial}}

{{> layouts/base}}